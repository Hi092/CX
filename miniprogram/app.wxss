/* 全局样式 */
page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
}

/* 全局图片基础样式 - 圆角矩形、不露白底 */
image {
  overflow: hidden;
  object-fit: cover;
  display: block;
}

.container {
  padding: 20rpx;
}

/* 通用按钮样式 */
.btn-primary {
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
}

.btn-primary::after {
  border: none;
}

/* 价格样式 */
.price {
  font-weight: bold;
}

.price .symbol {
  font-size: 24rpx;
}

.price .num {
  font-size: 36rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty .icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty .text {
  font-size: 28rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

/* flex布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}
