/* 销售统计页面 - 精致版 */
.container {
  background: #f8f9fb;
  min-height: 100vh;
  padding: 0 0 40rpx;
}

/* 日期范围选择 */
.date-bar {
  display: flex;
  background: #fff;
  padding: 24rpx;
  gap: 16rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.date-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #3a3a3c;
  font-weight: 500;
  background: #f2f2f7;
  transition: all 0.2s;
}
.date-item.active {
  color: #fff;
  font-weight: 600;
}

/* 自定义日期选择 */
.custom-date {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.date-pick-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f2f2f7;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
}
.date-label {
  font-size: 22rpx;
  color: #8e8e93;
}
.date-value {
  font-size: 26rpx;
  font-weight: 600;
}
.date-sep {
  font-size: 24rpx;
  color: #8e8e93;
}

/* 核心指标 */
.metrics-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 12rpx;
}
.metric-card {
  width: calc(50% - 6rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.metric-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 6rpx;
}
.metric-label {
  font-size: 22rpx;
  color: #8e8e93;
  font-weight: 500;
}

/* 通用区块 */
.section-card {
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 20rpx;
}

/* 柱状图 */
.chart-area {
  overflow-x: auto;
}
.bar-chart {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  min-height: 220rpx;
  padding-bottom: 40rpx;
  position: relative;
}
.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 40rpx;
}
.bar-value {
  font-size: 18rpx;
  color: #8e8e93;
  margin-bottom: 4rpx;
}
.bar {
  width: 100%;
  max-width: 40rpx;
  border-radius: 6rpx 6rpx 0 0;
  min-height: 4rpx;
  transition: height 0.3s ease;
}
.bar-label {
  font-size: 16rpx;
  color: #8e8e93;
  margin-top: 8rpx;
  white-space: nowrap;
}

/* 热销商品 */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.product-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.product-rank {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #8e8e93;
  font-weight: 600;
  flex-shrink: 0;
}
.product-rank.top {
  background: #FF9500;
  color: #fff;
}
.product-info {
  flex: 1;
  min-width: 0;
}
.product-name {
  font-size: 24rpx;
  color: #3a3a3c;
  display: block;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-bar-bg {
  height: 8rpx;
  background: #f2f2f7;
  border-radius: 4rpx;
  overflow: hidden;
}
.product-bar {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}
.product-stats {
  text-align: right;
  flex-shrink: 0;
}
.product-qty {
  display: block;
  font-size: 22rpx;
  color: #3a3a3c;
  font-weight: 600;
}
.product-income {
  font-size: 20rpx;
  color: #8e8e93;
}

/* 时段分布 */
.hour-chart {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.hour-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hour-label {
  width: 60rpx;
  font-size: 20rpx;
  color: #8e8e93;
  text-align: right;
  flex-shrink: 0;
}
.hour-bar-bg {
  flex: 1;
  height: 16rpx;
  background: #f2f2f7;
  border-radius: 8rpx;
  overflow: hidden;
}
.hour-bar {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}
.hour-count {
  width: 40rpx;
  font-size: 20rpx;
  color: #3a3a3c;
  text-align: left;
  font-weight: 500;
}

.empty-chart {
  text-align: center;
  padding: 40rpx;
  color: #c7c7cc;
  font-size: 24rpx;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #8e8e93;
}
