/* 商家后台首页样式 */
.container { background: #f5f6fa; min-height: 100vh; padding: 0; width: 100%; box-sizing: border-box; }

/* 头部 - 白色简洁 */
.header {
  padding: 40rpx 32rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
  background: #fff;
  width: 100%;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f0f0f0;
}
.shop-info { display: flex; align-items: center; }
.shop-info-left { margin-right: 24rpx; }
.shop-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
}
.shop-avatar-default {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #fff;
  font-weight: bold;
}
.shop-info-center { flex: 1; }
.shop-name {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
  color: #1a1a1a;
}
.shop-status-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}
.shop-status-tag.open { background: #E8F5E9; color: #4CAF50; }
.shop-status-tag.closed { background: #FFF3E0; color: #FF9800; }
.shop-status-tag .status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.shop-status-tag.open .status-dot { background: #4CAF50; }
.shop-status-tag.closed .status-dot { background: #ff9800; }

/* 统计网格 - 每张卡片独立渐变 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx 24rpx 0;
}
.stat-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.stat-card.orders  { background: linear-gradient(135deg, #E8F5E9, #C8E6C9); }
.stat-card.income  { background: linear-gradient(135deg, #FFF3E6, #FFE0B2); }
.stat-card.products { background: linear-gradient(135deg, #E3F2FD, #BBDEFB); }
.stat-card.pending { background: linear-gradient(135deg, #FDE8E8, #FFCDD2); }

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: #333;
  position: relative;
  z-index: 1;
}
.stat-label {
  font-size: 24rpx;
  color: #666;
  position: relative;
  z-index: 1;
}
.stat-icon {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 56rpx;
  opacity: 0.4;
}

/* 收入统计卡片 */
.revenue-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.revenue-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.revenue-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.revenue-grid {
  display: flex;
  justify-content: space-between;
}
.revenue-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  margin: 0 6rpx;
}
.revenue-item:first-child { margin-left: 0; }
.revenue-item:last-child { margin-right: 0; }
.revenue-item.yesterday { background: #FFF8E1; }
.revenue-item.week { background: #E8F5E9; }
.revenue-item.month { background: #E3F2FD; }
.revenue-item.year { background: #F3E5F5; }
.revenue-label {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-bottom: 8rpx;
}
.revenue-num {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

/* 菜单卡片 */
.menu-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.menu-info { flex: 1; }
.menu-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
  color: #1a1a1a;
}
.menu-desc {
  font-size: 24rpx;
  color: #999;
}
.menu-arrow {
  color: #ccc;
  font-size: 36rpx;
  margin-left: 10rpx;
  font-weight: 300;
}
.menu-badge {
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  margin-right: 14rpx;
}

/* 退出按钮 */
.logout-btn {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin: 24rpx;
  margin-top: 0;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.logout-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.logout-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}
