/* 商家后台首页样式 */
.container { background: #f5f5f5; min-height: 100vh; }
.header { padding: 40rpx; color: #fff; }
.shop-info { display: flex; align-items: center; justify-content: space-between; }
.shop-name { font-size: 36rpx; font-weight: bold; }
.shop-status { background: rgba(255,255,255,0.3); padding: 8rpx 20rpx; border-radius: 20rpx; font-size: 24rpx; }

/* 统计网格 */
.stats-grid { display: flex; flex-wrap: wrap; gap: 20rpx; padding: 20rpx; margin-top: -20rpx; }
.stat-card { background: #fff; border-radius: 16rpx; padding: 30rpx; text-align: center; width: calc(50% - 10rpx); box-sizing: border-box; }
.stat-num { display: block; font-size: 40rpx; font-weight: bold; margin-bottom: 10rpx; }
.stat-label { font-size: 24rpx; color: #999; }

/* 菜单卡片 */
.menu-card { background: #fff; margin: 20rpx; border-radius: 16rpx; overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 30rpx; border-bottom: 1rpx solid #f5f5f5; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 48rpx; margin-right: 20rpx; }
.menu-info { flex: 1; }
.menu-title { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 5rpx; }
.menu-desc { font-size: 24rpx; color: #999; }
.arrow { color: #ccc; font-size: 32rpx; }

/* 退出按钮 */
.logout-btn { text-align: center; padding: 30rpx; margin: 40rpx 20rpx; background: #fff; border-radius: 16rpx; font-size: 30rpx; }
