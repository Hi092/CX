<!--商家后台首页-->
<view class="container">
  <!-- 头部 - 柔和暖色渐变 -->
  <view class="header">
    <view class="shop-info">
      <view class="shop-info-left">
        <image class="shop-avatar" src="{{shopAvatar}}" mode="aspectFill" wx:if="{{shopAvatar}}"/>
        <view class="shop-avatar-default" wx:else>🏪</view>
      </view>
      <view class="shop-info-center">
        <text class="shop-name">{{shopName}}</text>
        <view class="shop-status-tag {{shopStatus === '营业中' ? 'open' : 'closed'}}">
          <text class="status-dot"></text>
          <text>{{shopStatus}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计卡片 - 渐变背景 -->
  <view class="stats-grid">
    <view class="stat-card orders">
      <text class="stat-num">{{todayOrders}}</text>
      <text class="stat-label">今日订单</text>
      <view class="stat-icon">📋</view>
    </view>
    <view class="stat-card income">
      <text class="stat-num">¥{{todayIncome}}</text>
      <text class="stat-label">今日收入</text>
      <view class="stat-icon">💰</view>
    </view>
    <view class="stat-card products">
      <text class="stat-num">{{totalProducts}}</text>
      <text class="stat-label">商品数量</text>
      <view class="stat-icon">📦</view>
    </view>
    <view class="stat-card pending">
      <text class="stat-num">{{pendingOrders}}</text>
      <text class="stat-label">待配送</text>
      <view class="stat-icon">🚚</view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goPage" data-url="/pages/admin/orders/orders">
      <view class="menu-icon-box" style="background:{{themeColor}}15">
        <image class="menu-icon-img" src="data:image/svg+xml;base64," mode="aspectFit"/>
      </view>
      <view class="menu-info">
        <text class="menu-title">订单管理</text>
        <text class="menu-desc">查看和处理订单</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/admin/products/products">
      <view class="menu-icon-box" style="background:{{themeColor}}15">
        <image class="menu-icon-img" src="data:image/svg+xml;base64," mode="aspectFit"/>
      </view>
      <view class="menu-info">
        <text class="menu-title">商品管理</text>
        <text class="menu-desc">添加、编辑商品</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/admin/settings/settings">
      <view class="menu-icon-box" style="background:{{themeColor}}15">
        <image class="menu-icon-img" src="data:image/svg+xml;base64," mode="aspectFit"/>
      </view>
      <view class="menu-info">
        <text class="menu-title">店铺设置</text>
        <text class="menu-desc">营业时间、配送范围</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/admin/printer/printer">
      <view class="menu-icon-box" style="background:{{themeColor}}15">
        <image class="menu-icon-img" src="data:image/svg+xml;base64," mode="aspectFit"/>
      </view>
      <view class="menu-info">
        <text class="menu-title">打印机设置</text>
        <text class="menu-desc">配置小票打印机</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出商家模式 -->
  <view class="logout-btn" bindtap="exitAdmin">
    <view class="logout-icon-box">
      <image class="menu-icon-img" src="data:image/svg+xml;base64," mode="aspectFit"/>
    </view>
    <text class="logout-text">退出商家模式</text>
  </view>
</view>
