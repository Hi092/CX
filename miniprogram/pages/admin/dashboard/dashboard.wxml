<!--商家后台首页-->
<view class="container">
  <!-- 头部 - 白色简洁 -->
  <view class="header">
    <view class="shop-info">
      <view class="shop-info-left">
        <image class="shop-avatar" wx:if="{{shopAvatar}}" src="{{shopAvatar}}" mode="aspectFill"/>
        <view class="shop-avatar-default" wx:else>
          <text>{{shopName[0] || '店'}}</text>
        </view>
      </view>
      <view class="shop-info-center">
        <text class="shop-name">{{shopName}}</text>
        <view class="shop-status-tag {{shopStatus === '营业中' ? 'open' : 'closed'}}">
          <view class="status-dot"></view>
          <text>{{shopStatus}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-grid">
    <view class="stat-card orders">
      <text class="stat-num">{{todayOrders}}</text>
      <text class="stat-label">今日订单</text>
      <view class="stat-icon"><icon type="list" size="28" color="{{themeColor}}"/></view>
    </view>
    <view class="stat-card income">
      <text class="stat-num">¥{{todayIncome}}</text>
      <text class="stat-label">今日收入</text>
      <view class="stat-icon"><icon type="money" size="28" color="{{themeColor}}"/></view>
    </view>
    <view class="stat-card products">
      <text class="stat-num">{{totalProducts}}</text>
      <text class="stat-label">商品数量</text>
      <view class="stat-icon"><icon type="package" size="28" color="{{themeColor}}"/></view>
    </view>
    <view class="stat-card pending">
      <text class="stat-num">{{pendingOrders}}</text>
      <text class="stat-label">待配送</text>
      <view class="stat-icon"><icon type="truck" size="28" color="{{themeColor}}"/></view>
    </view>
  </view>

  <!-- 库存预警 -->
  <view class="alert-card" wx:if="{{lowStockProducts.length > 0}}">
    <view class="alert-header">
      <icon type="info" size="18" color="#FF9500"/>
      <text class="alert-title">库存预警</text>
    </view>
    <view class="alert-list">
      <view class="alert-item" wx:for="{{lowStockProducts}}" wx:key="name">
        <text class="alert-name">{{item.name}}</text>
        <text class="alert-stock" style="color:{{item.stock <= 2 ? '#ff3b30' : '#FF9500'}}">剩余{{item.stock}}件</text>
      </view>
    </view>
    <view class="alert-action" bindtap="goPage" data-url="/pages/admin/products/products">
      <text style="color:{{themeColor}}">去补货</text>
      <icon type="arrow-right" size="14" color="{{themeColor}}"/>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goPage" data-url="/pages/admin/orders/orders">
      <view class="menu-icon-box" style="background:#E8F5E9">
        <icon type="list" size="24" color="#4CAF50"/>
      </view>
      <view class="menu-info">
        <text class="menu-title">订单管理</text>
        <text class="menu-desc">查看和处理订单</text>
      </view>
      <text class="menu-badge" wx:if="{{pendingOrders > 0}}">{{pendingOrders}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/admin/products/products">
      <view class="menu-icon-box" style="background:#E3F2FD">
        <icon type="package" size="24" color="#2196F3"/>
      </view>
      <view class="menu-info">
        <text class="menu-title">商品管理</text>
        <text class="menu-desc">添加、编辑商品</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/admin/stats/stats">
      <view class="menu-icon-box" style="background:#E8F5E9">
        <icon type="money" size="24" color="#4CAF50"/>
      </view>
      <view class="menu-info">
        <text class="menu-title">销售统计</text>
        <text class="menu-desc">销售趋势、热销商品</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/admin/settings/settings">
      <view class="menu-icon-box" style="background:#FFF3E6">
        <icon type="settings" size="24" color="#FF9800"/>
      </view>
      <view class="menu-info">
        <text class="menu-title">店铺设置</text>
        <text class="menu-desc">营业时间、配送范围</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/admin/password/password">
      <view class="menu-icon-box" style="background:#FDE8E8">
        <icon type="lock" size="24" color="#e74c3c"/>
      </view>
      <view class="menu-info">
        <text class="menu-title">密码设置</text>
        <text class="menu-desc">修改管理密码</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/admin/printer/printer">
      <view class="menu-icon-box" style="background:#E8EAF6">
        <icon type="download" size="24" color="#3F51B5"/>
      </view>
      <view class="menu-info">
        <text class="menu-title">打印机设置</text>
        <text class="menu-desc">配置小票打印机</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出商家模式 -->
  <view class="logout-btn" bindtap="exitAdmin">
    <view class="logout-icon-box" style="background:#FDE8E8">
      <icon type="close" size="24" color="#e74c3c"/>
    </view>
    <text class="logout-text">退出商家模式</text>
  </view>
</view>
