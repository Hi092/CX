<!--pages/admin/printer/printer.wxml-->
<view class="container">
  <view class="card">
    <view class="row">
      <text class="lbl">启用云打印</text>
      <switch checked="{{printerEnabled}}" bindchange="togglePrinter" color="{{themeColor}}"/>
    </view>
    <view class="tip">开启后新订单自动打印小票</view>
  </view>

  <block wx:if="{{printerEnabled}}">
    <view class="card">
      <view class="card-title">打印机信息</view>
      <view class="field">
        <text class="field-label">打印机名称</text>
        <input class="field-input" value="{{printerName}}" bindinput="onPrinterNameInput" placeholder="备注名，如：前台打印机"/>
      </view>
      <view class="field">
        <text class="field-label">打印机IP地址</text>
        <input class="field-input" value="{{printerIp}}" bindinput="onPrinterIpInput" placeholder="如：192.168.2.100" type="text"/>
      </view>
      <view class="field">
        <text class="field-label">端口号</text>
        <input class="field-input" value="{{printerPort}}" bindinput="onPrinterPortInput" placeholder="默认9100" type="number"/>
      </view>
      <view class="tip">小票打印机通常使用9100端口</view>
    </view>

    <view class="card">
      <view class="card-title">打印参数</view>
      <view class="row">
        <text class="lbl">纸张规格</text>
        <picker range="{{paperList}}" bindchange="onPaperChange">
          <text class="val">{{printerPaper}} ▸</text>
        </picker>
      </view>
      <view class="row">
        <text class="lbl">打印联数</text>
        <view class="copies">
          <input class="copies-input" value="{{printerCopies}}" bindinput="onPrinterCopiesInput" type="number"/>
          <text class="copies-unit">联</text>
        </view>
      </view>
      <view class="row">
        <text class="lbl">新订单自动打印</text>
        <switch checked="{{autoPrint}}" bindchange="toggleAutoPrint" color="{{themeColor}}"/>
      </view>
    </view>

    <view class="card">
      <view class="card-title">连接测试</view>
      <view class="row">
        <text class="lbl">目标打印机</text>
        <text class="val" wx:if="{{printerIp}}">{{printerName || '未命名'}} ({{printerIp}}:{{printerPort}})</text>
        <text class="val gray" wx:else>请先填写IP地址</text>
      </view>
      <view class="row">
        <text class="lbl">纸张规格</text>
        <text class="val">{{printerPaper}} / {{printerCopies}}联</text>
      </view>
      <button class="test-btn" bindtap="testPrint" loading="{{testPrinting}}" disabled="{{testPrinting}}" style="background:{{themeColor}}">
        {{testPrinting ? '正在测试...' : '发送测试打印'}}
      </button>
      <view class="tip" style="text-align:center">确认打印机已开机并连接同一WiFi</view>
    </view>
  </block>

  <view class="save-area">
    <button class="save-btn" bindtap="saveSettings" loading="{{loading}}" disabled="{{loading}}" style="background:{{themeColor}}">保存设置</button>
  </view>
</view>
