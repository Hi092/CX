/* pages/admin/printer/printer.wxss */
page { background: #f5f5f5; }
.container { min-height: 100vh; background: #f5f5f5; }

.card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 12rpx 28rpx;
}
.card-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  padding: 24rpx 0 8rpx 0;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.row:last-child { border-bottom: none; }
.lbl { font-size: 28rpx; color: #333; }
.val { font-size: 28rpx; color: #666; }
.val.gray { color: #ccc; }

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.field-label {
  font-size: 28rpx;
  color: #333;
  padding-bottom: 12rpx;
}
.field-input {
  font-size: 28rpx;
  color: #333;
  padding: 18rpx 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
}

.copies { display: flex; align-items: center; }
.copies-input {
  font-size: 28rpx;
  color: #333;
  padding: 14rpx 18rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
  width: 120rpx;
  text-align: center;
}
.copies-unit { font-size: 26rpx; color: #999; margin-left: 12rpx; }

.tip { font-size: 24rpx; color: #999; padding: 12rpx 0 20rpx 0; line-height: 1.5; }

.test-btn {
  margin: 24rpx 0 12rpx 0;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
}
.test-btn::after { border: none; }

.save-area { padding: 32rpx 24rpx 60rpx 24rpx; }
.save-btn {
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.save-btn::after { border: none; }
