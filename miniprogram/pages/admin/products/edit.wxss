/* 商品编辑页样式 */

/* 图片上传区域 */
.image-section {
  padding: 30rpx;
}

.image-upload {
  width: 100%;
  height: 400rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.change-text {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.5);
  color: #fff;
  text-align: center;
  padding: 15rpx;
  font-size: 26rpx;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #999;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  margin: 0 30rpx 30rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.textarea-item {
  flex-direction: column;
  align-items: flex-start;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.textarea-item .label {
  width: 100%;
  margin-bottom: 20rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

.textarea-item .input, .textarea-item .textarea {
  width: 100%;
}

.textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.placeholder {
  color: #999;
}

/* 价格输入 */
.price-input {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.price-input .symbol {
  font-size: 32rpx;
  color: #FF6B00;
  margin-right: 10rpx;
}

.price-input .input {
  text-align: right;
}

/* 选择器 */
.picker {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: 28rpx;
}

.arrow {
  margin-left: 10rpx;
  color: #ccc;
}

/* 保存按钮 */
.btn-section {
  padding: 30rpx;
}

.save-btn {
  background: #FF6B00;
  color: #fff;
  border: none;
  border-radius: 50rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}

.save-btn::after {
  border: none;
}
