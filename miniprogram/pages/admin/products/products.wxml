<!--商品管理页面-->
<view class="container">
  <!-- 添加按钮 -->
  <view class="add-bar">
    <text class="title">商品管理</text>
    <button class="add-btn" bindtap="addProduct">+ 添加商品</button>
  </view>

  <!-- 商品列表 -->
  <view class="product-list" wx:if="{{!loading}}">
    <view class="product-card" wx:for="{{products}}" wx:key="_id">
      <image src="{{item.image || '/images/default.png'}}" class="product-img" mode="aspectFill"/>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-category">{{item.category}}</text>
        <view class="product-meta">
          <text class="product-price">¥{{item.price}}</text>
          <text class="product-stock">库存: {{item.stock}}</text>
        </view>
      </view>
      <view class="product-actions">
        <view class="status-tag {{item.statusClass}}">{{item.statusText}}</view>
        <view class="action-row">
          <text class="action-link" bindtap="editProduct" data-id="{{item._id}}">编辑</text>
          <text class="action-link" bindtap="toggleStatus" data-id="{{item._id}}" data-status="{{item.status}}">
            {{item.status === 'on' ? '下架' : '上架'}}
          </text>
          <text class="action-link delete" bindtap="deleteProduct" data-id="{{item._id}}">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && products.length === 0}}">
    <view class="icon">🛍️</view>
    <text class="text">还没有商品</text>
    <button class="add-btn" bindtap="addProduct">添加第一个商品</button>
  </view>
</view>
