<!--商品管理页面-->
<view class="container">
  <!-- 顶部栏 -->
  <view class="header" style="background:linear-gradient(135deg, {{themeColor}}, {{themeColor}}88)">
    <text class="title">商品管理</text>
    <view class="add-btn" bindtap="addProduct">+ 添加</view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索商品名称..." value="{{searchKey}}" bindinput="onSearch" bindconfirm="doSearch"/>
      <text class="search-clear" wx:if="{{searchKey}}" bindtap="clearSearch">✕</text>
    </view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="filter-bar" scroll-x>
    <view class="filter-item {{currentCategory === '' ? 'active' : ''}}" 
          style="{{currentCategory === '' ? 'background:' + themeColor + ';color:#fff' : ''}}"
          bindtap="filterCategory" data-id="">全部</view>
    <view class="filter-item {{currentCategory === item ? 'active' : ''}}" 
          style="{{currentCategory === item ? 'background:' + themeColor + ';color:#fff' : ''}}"
          wx:for="{{categories}}" wx:key="*this"
          bindtap="filterCategory" data-id="{{item}}">{{item}}</view>
  </scroll-view>

  <!-- 商品列表 -->
  <scroll-view class="product-list" scroll-y wx:if="{{!loading}}">
    <view class="product-card" wx:for="{{products}}" wx:key="_id" bindtap="viewProduct" data-id="{{item._id}}">
      <image src="{{item.image || '/images/default.png'}}" class="product-img" mode="aspectFill"/>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-category">{{item.category}}</text>
        <view class="product-bottom">
          <text class="product-price" style="color:{{themeColor}}">¥{{item.price}}</text>
          <text class="product-stock" wx:if="{{item.stock <= 5}}" style="color:#F44336">库存不足</text>
          <text class="product-stock" wx:else>库存: {{item.stock}}</text>
        </view>
      </view>
      <view class="product-actions">
        <view class="status-tag {{item.status}}" style="{{item.status === 'on' ? 'background:' + themeColor + '15;color:' + themeColor : 'background:#FFEBEE;color:#F44336'}}">
          <text>{{item.status === 'on' ? '在售' : '已下架'}}</text>
        </view>
        <view class="action-row">
          <view class="action-btn" catchtap="editProduct" data-id="{{item._id}}" style="color:{{themeColor}}">✏️</view>
          <view class="action-btn" catchtap="toggleStatus" data-id="{{item._id}}" data-status="{{item.status}}">
            <text>{{item.status === 'on' ? '⬇️' : '⬆️'}}</text>
          </view>
          <view class="action-btn delete" catchtap="deleteProduct" data-id="{{item._id}}">🗑️</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="loading" wx:if="{{loading}}"><text class="loading-icon">⏳</text><text>加载中...</text></view>
  <view class="empty" wx:if="{{!loading && products.length === 0}}">
    <text class="empty-icon">📦</text>
    <text class="empty-text">暂无商品</text>
    <button class="empty-btn" style="background:{{themeColor}}" bindtap="addProduct">添加商品</button>
  </view>
</view>
