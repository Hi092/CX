<!--商品编辑页面-->
<view class="container">
  <!-- 商品图片 -->
  <view class="image-section">
    <view class="image-upload" bindtap="chooseImage">
      <block wx:if="{{image}}">
        <image src="{{image}}" class="preview-img" mode="aspectFill"/>
        <text class="change-text">点击更换</text>
      </block>
      <block wx:else>
        <icon type="camera" size="40" color="#ccc"/>
        <text class="upload-text">添加商品图片</text>
      </block>
    </view>
  </view>

  <!-- 表单 -->
  <view class="form-card">
    <view class="form-item">
      <text class="label">商品名称</text>
      <input class="input" placeholder="请输入商品名称" bindinput="onNameInput" value="{{name}}"/>
    </view>
    <view class="form-item">
      <text class="label">价格</text>
      <view class="price-input">
        <text class="symbol" style="color:{{themeColor}}">¥</text>
        <input class="input" type="digit" placeholder="0.00" bindinput="onPriceInput" value="{{price}}"/>
      </view>
    </view>
    <view class="form-item">
      <text class="label">库存</text>
      <input class="input" type="number" placeholder="请输入库存数量" bindinput="onStockInput" value="{{stock}}"/>
    </view>
    <view class="form-item">
      <text class="label">分类</text>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker">
          <text wx:if="{{category}}">{{category}}</text>
          <text wx:else class="placeholder">请选择分类</text>
          <icon type="arrow-right" size="16" color="#ccc"/>
        </view>
      </picker>
    </view>
    <view class="form-item textarea-item">
      <text class="label">商品描述</text>
      <textarea class="textarea" placeholder="选填，商品描述信息" bindinput="onDescInput" value="{{description}}"/>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="btn-section">
    <button class="save-btn" style="background:{{themeColor}}" bindtap="saveProduct" loading="{{loading}}">
      {{isEdit ? '保存修改' : '添加商品'}}
    </button>
  </view>
</view>
