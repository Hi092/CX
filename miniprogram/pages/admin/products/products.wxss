/* 商品管理样式 */
.container { background: #f5f5f5; min-height: 100vh; }

/* 顶部栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  color: #fff;
}

.header .title {
  font-size: 36rpx;
  font-weight: bold;
}

.add-btn {
  background: rgba(255,255,255,0.25);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 12rpx 30rpx;
  font-size: 28rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 20rpx;
  background: #fff;
}

.search-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 0 10rpx;
}

/* 分类筛选 */
.filter-bar {
  white-space: nowrap;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f5;
}

.filter-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
}

/* 商品卡片 */
.product-card {
  display: flex;
  background: #fff;
  padding: 20rpx;
  margin-bottom: 2rpx;
  align-items: flex-start;
}

.product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
  overflow: hidden;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-right: 16rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.product-category {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
  margin-bottom: 10rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 32rpx;
  font-weight: bold;
}

.product-stock {
  font-size: 24rpx;
  color: #999;
}

/* 操作区域 */
.product-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.action-btn.delete {
  background: #FFEBEE;
}

/* 加载和空状态 */
.loading, .empty {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  margin-bottom: 30rpx;
}

.empty-btn {
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 60rpx;
  font-size: 30rpx;
}
