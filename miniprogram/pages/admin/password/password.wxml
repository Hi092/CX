<!--密码设置页面-->
<view class="container">
  <view class="page-header" style="background:linear-gradient(135deg, #4A90D9, #4A90D988)">
    <text class="page-title">密码设置</text>
  </view>

  <view class="form-card">
    <view class="form-item">
      <text class="label">当前密码</text>
      <input class="input" type="number" password placeholder="请输入当前密码" bindinput="onOldPwdInput" value="{{oldPassword}}"/>
    </view>
    <view class="form-item">
      <text class="label">新密码</text>
      <input class="input" type="number" password placeholder="请输入新密码" bindinput="onNewPwdInput" value="{{newPassword}}"/>
    </view>
    <view class="form-item">
      <text class="label">确认密码</text>
      <input class="input" type="number" password placeholder="请再次输入新密码" bindinput="onConfirmPwdInput" value="{{confirmPassword}}"/>
    </view>
  </view>

  <view class="btn-section">
    <button class="save-btn" style="background:#4A90D9" bindtap="savePassword" loading="{{loading}}">
      保存密码
    </button>
  </view>
</view>
