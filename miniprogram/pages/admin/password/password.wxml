<!--密码设置页面-->
<view class="container">
  <!-- 顶部导航 -->
  <view class="page-header">
    <text class="page-title">密码设置</text>
  </view>

  <!-- 密码表单 -->
  <view class="card">
    <view class="card-header">
      <view class="card-icon" style="background:#FDE8E8">
        <text style="font-size:28rpx">🔐</text>
      </view>
      <text class="card-title">修改密码</text>
    </view>

    <view class="form-item">
      <text class="label">当前密码</text>
      <input class="input" type="number" password placeholder="请输入当前密码"
             bindinput="onOldPwdInput" value="{{oldPassword}}"/>
    </view>

    <view class="form-item">
      <text class="label">新密码</text>
      <input class="input" type="number" password placeholder="请输入新密码"
             bindinput="onNewPwdInput" value="{{newPassword}}"/>
    </view>

    <view class="form-item last">
      <text class="label">确认密码</text>
      <input class="input" type="number" password placeholder="请再次输入新密码"
             bindinput="onConfirmPwdInput" value="{{confirmPassword}}"/>
    </view>
  </view>

  <!-- 提示 -->
  <view class="tip-card">
    <text class="tip-icon">💡</text>
    <text class="tip-text">密码至少4位，修改后需要重新登录</text>
  </view>

  <!-- 保存按钮 -->
  <view class="btn-section">
    <button class="save-btn" bindtap="savePassword" loading="{{loading}}">
      保存密码
    </button>
  </view>

  <!-- 取消免密登录 -->
  <view class="btn-section" wx:if="{{hasAutoLogin}}">
    <button class="clear-auto-btn" bindtap="clearAutoLogin">
      🔓 取消免密登录
    </button>
    <text class="clear-tip">当前设备已记住密码，无需输入即可进入后台</text>
  </view>
</view>
