/* 密码设置 - 白色简洁风格 */
page {
  background: #f5f6fa;
  min-height: 100vh;
}
.container {
  padding: 0 0 40rpx;
}

/* 顶部导航 */
.page-header {
  background: #fff;
  padding: 30rpx 32rpx;
  padding-top: calc(30rpx + env(safe-area-inset-top));
  border-bottom: 1rpx solid #f0f0f0;
}
.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 0 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.card-header {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.card-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.form-item.last {
  border-bottom: none;
}
.label {
  font-size: 30rpx;
  color: #333;
  width: 180rpx;
  flex-shrink: 0;
  font-weight: 500;
}
.input {
  flex: 1;
  font-size: 30rpx;
  text-align: right;
  color: #333;
}

/* 提示卡片 */
.tip-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 24rpx;
  padding: 20rpx 24rpx;
  background: #FFF8E1;
  border-radius: 16rpx;
}
.tip-icon {
  font-size: 28rpx;
}
.tip-text {
  font-size: 24rpx;
  color: #F57C00;
  flex: 1;
}

/* 保存按钮 */
.btn-section {
  padding: 40rpx 24rpx 60rpx;
}
.save-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(102,126,234,0.3);
  letter-spacing: 2rpx;
}
.save-btn::after {
  border: none;
}
