/* 商家订单管理 - 精致版 */
.container {
  background: #f8f9fb;
  min-height: 100vh;
  padding: 0 0 40rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 统计卡片 - 白底简洁 */
.stats-card {
  display: flex;
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  margin: 0;
  background: #fff;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
  width: 100%;
  box-sizing: border-box;
}
.stat-item { flex: 1; text-align: center; }
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 6rpx;
  color: #1a1a2e;
}
.stat-label {
  font-size: 22rpx;
  color: #8e8e93;
  font-weight: 500;
}
.stat-divider {
  width: 1rpx;
  background: rgba(0,0,0,0.06);
  margin: 0 24rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 24rpx;
  background: #fff;
}
.search-wrap {
  display: flex;
  align-items: center;
  background: #f2f2f7;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  gap: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1a1a2e;
}
.search-clear {
  padding: 4rpx;
}

/* Tab栏 */
.tab-bar {
  display: flex;
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #8e8e93;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  font-weight: 500;
}
.tab.active {
  font-weight: 600;
  color: #1a1a2e;
}
.tab-line {
  width: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
  margin-top: 6rpx;
}
.tab-badge {
  position: absolute;
  top: 6rpx;
  right: 16rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  text-align: center;
}

/* 订单卡片 */
.order-card {
  background: #fff;
  margin: 12rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.order-no {
  font-size: 22rpx;
  color: #8e8e93;
  font-family: monospace;
}
.order-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 500;
}
.order-status.delivering {
  background: #E3F2FD;
  color: #1565C0;
}
.order-status.completed {
  background: #E8F5E9;
  color: #2E7D32;
}

.order-user {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #3a3a3c;
}
.order-address {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 16rpx;
}
.order-items {
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}
.item {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 24rpx;
}
.item-name {
  flex: 1;
  color: #3a3a3c;
}
.item-qty {
  color: #8e8e93;
  margin-left: 16rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.order-time {
  font-size: 22rpx;
  color: #8e8e93;
}
.order-price {
  font-size: 26rpx;
  color: #3a3a3c;
}
.order-price .price {
  font-weight: 700;
  font-size: 30rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
}
.action-btn {
  min-width: 160rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  border-radius: 28rpx;
  border: none;
  margin-left: 16rpx;
  font-weight: 600;
}
.action-btn::after { border: none; }
.action-btn.primary { color: #fff; }
.action-btn.success { background: #34C759; color: #fff; }
.action-btn.disabled { background: #f2f2f7; color: #8e8e93; }

.loading, .empty {
  text-align: center;
  padding: 80rpx;
  color: #8e8e93;
}
.empty .icon {
  margin-bottom: 16rpx;
}
