/* 商家订单管理样式 */
.container { background: #f5f5f5; min-height: 100vh; padding: 0; width: 100%; box-sizing: border-box; }

/* 统计卡片 - 暖色渐变 */
.stats-card {
  display: flex;
  padding: 40rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
  margin: 0;
  background: linear-gradient(180deg, #FFF3E6, #FFFFFF);
  border-radius: 0 0 24rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 48rpx; font-weight: bold; display: block; margin-bottom: 10rpx; color: #333; }
.stat-label { font-size: 24rpx; color: #999; }
.stat-divider { width: 1rpx; background: #FFD9B3; margin: 0 30rpx; }

.tab-bar {
  display: flex;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.tab {
  flex: 1; text-align: center; padding: 24rpx 0;
  font-size: 28rpx; color: #666;
  display: flex; flex-direction: column; align-items: center;
  position: relative;
}
.tab.active { font-weight: bold; }
.tab-line { width: 40rpx; height: 4rpx; border-radius: 2rpx; margin-top: 8rpx; }
.tab-badge { position: absolute; top: 8rpx; right: 18rpx; min-width: 30rpx; height: 30rpx; line-height: 30rpx; padding: 0 8rpx; border-radius: 16rpx; background: #e74c3c; color: #fff; font-size: 20rpx; font-weight: 700; text-align: center; }

.order-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.order-no { font-size: 24rpx; color: #999; }
.order-status { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 20rpx; }
.order-status.delivering { background: #E3F2FD; color: #1976D2; }
.order-status.completed { background: #E8F5E9; color: #4CAF50; }

.order-user {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}
.order-address { font-size: 26rpx; color: #666; margin-bottom: 20rpx; }
.order-items {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.item { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 26rpx; }
.item-name { flex: 1; color: #333; }
.item-qty { color: #999; margin-left: 20rpx; }

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.order-time { font-size: 24rpx; color: #999; }
.order-price { font-size: 28rpx; }
.order-price .price { font-weight: bold; font-size: 32rpx; }

.order-actions { display: flex; justify-content: flex-end; }
.action-btn {
  min-width: 180rpx; height: 64rpx; line-height: 64rpx;
  font-size: 28rpx; border-radius: 32rpx; border: none; margin-left: 20rpx;
}
.action-btn::after { border: none; }
.action-btn.primary { color: #fff; }
.action-btn.success { background: #4CAF50; color: #fff; }
.action-btn.disabled { background: #f5f5f5; color: #999; }

.loading, .empty { text-align: center; padding: 100rpx; color: #999; }
.empty .icon { font-size: 80rpx; margin-bottom: 20rpx; }
