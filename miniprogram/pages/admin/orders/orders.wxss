/* 商家订单管理样式 */

/* 统计卡片 */
.stats-card {
  display: flex;
  background: linear-gradient(135deg, #FF6B00, #FF8C40);
  padding: 40rpx;
  margin: 20rpx;
  border-radius: 16rpx;
  color: #fff;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.stat-divider {
  width: 1rpx;
  background: rgba(255,255,255,0.3);
  margin: 0 30rpx;
}

/* Tab栏 */
.tab-bar {
  display: flex;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #FF6B00;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #FF6B00;
  border-radius: 2rpx;
}

/* 订单卡片 */
.order-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.order-status.pending {
  background: #FFF3E6;
  color: #FF6B00;
}

.order-status.delivering {
  background: #E3F2FD;
  color: #1976D2;
}

.order-status.completed {
  background: #E8F5E9;
  color: #4CAF50;
}

/* 收货人信息 */
.order-user {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

.call-icon {
  font-size: 36rpx;
}

.order-address {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

/* 商品明细 */
.order-items {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
}

.item-name {
  flex: 1;
  color: #333;
}

.item-qty {
  color: #999;
  margin-left: 20rpx;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-price {
  font-size: 28rpx;
}

.order-price .price {
  color: #FF6B00;
  font-weight: bold;
  font-size: 32rpx;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  min-width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  border-radius: 32rpx;
  border: none;
  margin-left: 20rpx;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: #FF6B00;
  color: #fff;
}

.action-btn.success {
  background: #4CAF50;
  color: #fff;
}

.action-btn.disabled {
  background: #f5f5f5;
  color: #999;
}

/* 加载和空状态 */
.loading, .empty {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

.empty .icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
