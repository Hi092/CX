<!--商家订单管理-->
<view class="container">
  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{stats.todayOrders}}</text>
      <text class="stat-label">今日订单</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">¥{{stats.todayIncome}}</text>
      <text class="stat-label">今日收入</text>
    </view>
  </view>

  <!-- Tab栏 -->
  <view class="tab-bar">
    <view class="tab {{currentTab === 'all' ? 'active' : ''}}" 
          bindtap="switchTab" data-tab="all">全部</view>
    <view class="tab {{currentTab === 'pending' ? 'active' : ''}}" 
          bindtap="switchTab" data-tab="pending">待配送</view>
    <view class="tab {{currentTab === 'delivering' ? 'active' : ''}}" 
          bindtap="switchTab" data-tab="delivering">配送中</view>
    <view class="tab {{currentTab === 'completed' ? 'active' : ''}}" 
          bindtap="switchTab" data-tab="completed">已完成</view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{!loading}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="_id">
      <!-- 订单头 -->
      <view class="order-header">
        <text class="order-no">订单号: {{item.orderNo}}</text>
        <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      
      <!-- 收货人信息 -->
      <view class="order-user" bindtap="callPhone" data-phone="{{item.address.phone}}">
        <text>👤 {{item.address.name}} · {{item.address.phone}}</text>
        <text class="call-icon">📞</text>
      </view>
      
      <!-- 收货地址 -->
      <view class="order-address">
        📍 {{item.address.community}} {{item.address.building}}栋 {{item.address.unit}}单元 {{item.address.room}}
      </view>
      
      <!-- 商品明细 -->
      <view class="order-items">
        <view class="item" wx:for="{{item.items}}" wx:for-item="product" wx:key="name">
          <text class="item-name">{{product.name}}</text>
          <text class="item-qty">x{{product.quantity}}</text>
        </view>
      </view>
      
      <!-- 订单底部 -->
      <view class="order-footer">
        <view class="order-time">{{item.createTimeText}}</view>
        <view class="order-price">
          合计: <text class="price">¥{{item.finalPrice}}</text>
        </view>
      </view>
      
      <!-- 操作按钮 -->
      <view class="order-actions">
        <block wx:if="{{item.status === 'pending'}}">
          <button class="action-btn primary" bindtap="startDelivery" data-id="{{item._id}}">
            开始配送
          </button>
        </block>
        <block wx:if="{{item.status === 'delivering'}}">
          <button class="action-btn success" bindtap="completeDelivery" data-id="{{item._id}}">
            确认送达
          </button>
        </block>
        <block wx:if="{{item.status === 'completed'}}">
          <button class="action-btn disabled" disabled>已完成</button>
        </block>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && orders.length === 0}}">
    <view class="icon">📦</view>
    <text class="text">暂无订单</text>
  </view>
</view>
