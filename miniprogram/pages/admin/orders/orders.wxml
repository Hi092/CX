<!--商家订单管理-->
<view class="container">
  <!-- 统计卡片 - 暖色渐变 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{stats.todayOrders}}</text>
      <text class="stat-label">今日订单</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">¥{{stats.todayIncome}}</text>
      <text class="stat-label">今日收入</text>
    </view>
  </view>

  <!-- Tab栏 -->
  <view class="tab-bar">
    <view class="tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">
      <text style="{{currentTab === 'all' ? 'color:' + themeColor : ''}}">全部</text>
      <view class="tab-line" wx:if="{{currentTab === 'all'}}" style="background:{{themeColor}}"></view>
    </view>
    <view class="tab {{currentTab === 'pending' ? 'active' : ''}}" bindtap="switchTab" data-tab="pending">
      <text style="{{currentTab === 'pending' ? 'color:' + themeColor : ''}}">待处理</text>
      <view class="tab-line" wx:if="{{currentTab === 'pending'}}" style="background:{{themeColor}}"></view>
    </view>
    <view class="tab {{currentTab === 'delivering' ? 'active' : ''}}" bindtap="switchTab" data-tab="delivering">
      <text style="{{currentTab === 'delivering' ? 'color:' + themeColor : ''}}">配送中</text>
      <view class="tab-line" wx:if="{{currentTab === 'delivering'}}" style="background:{{themeColor}}"></view>
    </view>
    <view class="tab {{currentTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-tab="completed">
      <text style="{{currentTab === 'completed' ? 'color:' + themeColor : ''}}">已完成</text>
      <view class="tab-line" wx:if="{{currentTab === 'completed'}}" style="background:{{themeColor}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{!loading}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="_id">
      <view class="order-header">
        <text class="order-no">订单号: {{item.orderNo}}</text>
        <text class="order-status {{item.statusClass}}"
              style="{{item.status === 'pending' ? 'background:#FFF3E0;color:#FF9800' : item.status === 'paid' ? 'background:' + themeColor + '22;color:' + themeColor : ''}}">{{item.statusText}}</text>
      </view>
      <view class="order-user" bindtap="callPhone" data-phone="{{item.address.phone}}">
        <text><icon type="user" size="14" color="#666"/> {{item.address.name}} · {{item.address.phone}}</text>
        <icon type="phone" size="18" color="{{themeColor}}"/>
      </view>
      <view class="order-address">
        <icon type="location" size="14" color="#999"/> {{item.address.community}} {{item.address.building}}栋 {{item.address.unit}}单元 {{item.address.room}}
      </view>
      <view class="order-items">
        <view class="item" wx:for="{{item.items}}" wx:for-item="product" wx:key="name">
          <text class="item-name">{{product.name}}</text>
          <text class="item-qty">x{{product.quantity}}</text>
        </view>
      </view>
      <view class="order-footer">
        <view class="order-time">{{item.createTimeText}}</view>
        <view class="order-price">
          合计: <text class="price" style="color:{{themeColor}}">¥{{item.finalPrice}}</text>
        </view>
      </view>
      <view class="order-actions">
        <block wx:if="{{item.status === 'pending'}}">
          <button class="action-btn disabled" disabled>待付款</button>
        </block>
        <block wx:if="{{item.status === 'paid'}}">
          <button class="action-btn primary" style="background:{{themeColor}}" bindtap="startDelivery" data-id="{{item._id}}">
            开始配送
          </button>
        </block>
        <block wx:if="{{item.status === 'delivering'}}">
          <button class="action-btn success" bindtap="completeDelivery" data-id="{{item._id}}">
            确认送达
          </button>
        </block>
        <block wx:if="{{item.status === 'completed'}}">
          <button class="action-btn disabled" disabled>已完成</button>
        </block>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="empty" wx:if="{{!loading && orders.length === 0}}">
    <view class="icon"><icon type="package" size="60" color="#ccc"/></view>
    <text class="text">暂无订单</text>
  </view>
</view>
