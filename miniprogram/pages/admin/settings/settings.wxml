<!--店铺设置页面-->
<view class="container">
  <!-- 顶部渐变头部 -->
  <view class="page-header" style="background:linear-gradient(135deg, {{themeColor}}, {{themeColor}}CC)">
    <view class="header-content">
      <view class="header-avatar" wx:if="{{shopAvatar}}">
        <image class="avatar-img" src="{{shopAvatar}}" mode="aspectFill"/>
      </view>
      <view class="header-avatar placeholder" wx:else>
        <text class="avatar-text">{{shopName[0] || '店'}}</text>
      </view>
      <view class="header-info">
        <text class="header-name">{{shopName}}</text>
        <view class="header-status">
          <text class="status-dot {{shopStatus === '营业中' ? 'open' : 'closed'}}"></text>
          <text class="status-text">{{shopStatus}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 店铺信息卡片 -->
  <view class="card">
    <view class="card-header">
      <view class="card-icon" style="background:{{themeColor}}22">
        <text style="color:{{themeColor}}">🏪</text>
      </view>
      <text class="card-title">店铺信息</text>
    </view>

    <view class="form-item" bindtap="chooseAvatar">
      <text class="label">店铺头像</text>
      <view class="item-right">
        <image class="preview-avatar" wx:if="{{shopAvatar}}" src="{{shopAvatar}}" mode="aspectFill"/>
        <text class="placeholder-text" wx:else>点击上传</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="form-item">
      <text class="label">店铺名称</text>
      <input class="input" placeholder="请输入店铺名称"
             bindinput="onNameInput" value="{{shopName}}"/>
    </view>

    <view class="form-item">
      <text class="label">营业状态</text>
      <picker mode="selector" range="{{statusList}}" bindchange="onStatusChange">
        <view class="item-right">
          <view class="status-badge {{shopStatus === '营业中' ? 'open' : 'closed'}}">
            <text class="badge-dot"></text>
            <text class="badge-text">{{shopStatus}}</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">联系电话</text>
      <input class="input" type="number" placeholder="请输入手机号"
             bindinput="onPhoneInput" value="{{shopPhone}}"/>
    </view>
  </view>

  <!-- 经营设置卡片 -->
  <view class="card">
    <view class="card-header">
      <view class="card-icon" style="background:{{themeColor}}22">
        <text style="color:{{themeColor}}">⏰</text>
      </view>
      <text class="card-title">经营设置</text>
    </view>

    <view class="form-item">
      <text class="label">营业时间</text>
      <view class="time-picker">
        <picker mode="time" value="{{openTime}}" bindchange="onOpenTimeChange">
          <view class="time-btn">
            <text class="time-text">{{openTime}}</text>
          </view>
        </picker>
        <text class="time-divider">至</text>
        <picker mode="time" value="{{closeTime}}" bindchange="onCloseTimeChange">
          <view class="time-btn">
            <text class="time-text">{{closeTime}}</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <text class="label">起送价</text>
      <view class="price-input">
        <text class="symbol">¥</text>
        <input class="input price" type="digit" placeholder="0"
               bindinput="onMinPriceInput" value="{{minPrice}}"/>
      </view>
    </view>

    <view class="form-item">
      <text class="label">配送费</text>
      <view class="price-input">
        <text class="symbol">¥</text>
        <input class="input price" type="digit" placeholder="0"
               bindinput="onDeliveryFeeInput" value="{{deliveryFee}}"/>
      </view>
    </view>

    <view class="form-item">
      <text class="label">满额免配送</text>
      <view class="price-input">
        <text class="symbol">¥</text>
        <input class="input price" type="digit" placeholder="0"
               bindinput="onFreeDeliveryInput" value="{{freeDeliveryPrice}}"/>
      </view>
    </view>

    <view class="form-item last">
      <text class="label">配送范围</text>
      <input class="input" placeholder="如：幸福小区"
             bindinput="onRangeInput" value="{{deliveryRange}}"/>
    </view>
  </view>

  <!-- 主题颜色卡片 -->
  <view class="card">
    <view class="card-header">
      <view class="card-icon" style="background:{{themeColor}}22">
        <text style="color:{{themeColor}}">🎨</text>
      </view>
      <text class="card-title">主题颜色</text>
      <view class="color-preview" style="background:{{themeColor}}"></view>
    </view>
    <view class="color-grid">
      <view class="color-item {{themeColor === item ? 'active' : ''}}"
            wx:for="{{colorList}}" wx:key="*this"
            style="background:{{item}}"
            bindtap="selectColor" data-color="{{item}}">
        <icon class="color-check" wx:if="{{themeColor === item}}" type="check" size="16" color="#fff"/>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="btn-section">
    <button class="save-btn" style="background:linear-gradient(135deg, {{themeColor}}, {{themeColor}}CC)"
            bindtap="saveSettings" loading="{{loading}}">
      保存设置
    </button>
  </view>
</view>
