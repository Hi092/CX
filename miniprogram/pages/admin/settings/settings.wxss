/* 店铺设置 - 精致版 */
page {
  background: #f8f9fb;
  min-height: 100vh;
}
.container {
  padding: 0 0 40rpx;
}

/* 顶部渐变头部 */
.page-header {
  padding: 40rpx 32rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
  position: relative;
  overflow: hidden;
}
.page-header::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: 0;
  right: 0;
  height: 80rpx;
  background: #f8f9fb;
  border-radius: 40rpx 40rpx 0 0;
}
.header-content {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}
.header-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.avatar-img {
  width: 100%;
  height: 100%;
}
.header-avatar.placeholder {
  background: rgba(255,255,255,0.3);
}
.avatar-text {
  font-size: 38rpx;
  color: #fff;
  font-weight: bold;
}
.header-info {
  flex: 1;
}
.header-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
}
.header-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fff;
  display: inline-block;
}
.status-dot.open { background: #4CAF50; }
.status-dot.closed { background: #FF9800; }
.status-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 24rpx 16rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative;
  z-index: 2;
}
.card-header {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.card-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.form-item.last {
  border-bottom: none;
}
.label {
  font-size: 28rpx;
  color: #3a3a3c;
  width: 180rpx;
  flex-shrink: 0;
  font-weight: 500;
}
.item-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}
.input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: #1a1a2e;
}
.input.price {
  font-weight: 600;
  color: #1a1a2e;
}
.placeholder-text {
  font-size: 26rpx;
  color: #c7c7cc;
}
.preview-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
}
.arrow {
  font-size: 28rpx;
  color: #c7c7cc;
  font-weight: 300;
}

/* 状态徽章 */
.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: #f2f2f7;
}
.status-badge.open {
  background: #E8F5E9;
}
.status-badge.closed {
  background: #FFF3E0;
}
.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #8e8e93;
}
.status-badge.open .badge-dot {
  background: #4CAF50;
}
.status-badge.closed .badge-dot {
  background: #FF9800;
}
.badge-text {
  font-size: 24rpx;
  color: #3a3a3c;
  font-weight: 500;
}

/* 时间选择 */
.time-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}
.time-btn {
  background: #f2f2f7;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
}
.time-text {
  font-size: 26rpx;
  color: #1a1a2e;
  font-weight: 500;
}
.time-divider {
  color: #8e8e93;
  font-size: 26rpx;
}

/* 价格输入 */
.price-input {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.symbol {
  font-size: 28rpx;
  color: #3a3a3c;
  margin-right: 8rpx;
  font-weight: 500;
}

/* 主题颜色 */
.color-preview {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}
.color-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 0 20rpx;
  gap: 16rpx;
}
.color-item {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}
.color-item.active {
  border-color: #fff;
  transform: scale(1.12);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}
.color-check {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

/* 保存按钮 */
.btn-section {
  padding: 24rpx 24rpx 60rpx;
}
.save-btn {
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12);
  letter-spacing: 2rpx;
}
.save-btn::after {
  border: none;
}
