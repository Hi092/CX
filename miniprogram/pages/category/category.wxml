<!-- WXS: 价格精度工具 -->
<wxs module="s">
var f = function(p, q) {
  return Math.round(p * q * 100) / 100;
}
module.exports.f = f;
</wxs>

<!--分类页面（默认启动页）-->
<view class="container">
  <!-- 顶部通栏：浅橙到白色渐变 -->
  <view class="shop-header">
    <view class="shop-info-row">
      <image class="shop-avatar" src="{{shopAvatar}}" mode="aspectFill" wx:if="{{shopAvatar}}"/>
      <view class="shop-avatar-default" wx:else>🏪</view>
      <view class="shop-detail">
        <view class="shop-name-row">
          <text class="shop-name">{{shopName}}</text>
          <text class="shop-status-tag {{shopStatus === '营业中' ? 'open' : 'closed'}}">{{shopStatus}}</text>
        </view>
        <text class="shop-sub">30分钟送达</text>
      </view>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-wrap">
      <icon type="search" size="16" color="#999"/>
      <input class="search-input" placeholder="搜索商品..." value="{{searchKey}}" bindinput="onSearch"/>
    </view>
  </view>

  <view class="main-content">
    <!-- 左侧分类 -->
    <scroll-view class="category-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="category-item {{currentCategory === index ? 'active' : ''}}" 
            wx:for="{{categories}}" wx:key="id"
            bindtap="switchCategory" data-index="{{index}}"
            style="{{currentCategory === index ? 'color:' + themeColor + ';background:#fff' : ''}}">
        <view class="active-bar" wx:if="{{currentCategory === index}}" style="background:{{themeColor}}"></view>
        <text>{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧商品 -->
    <scroll-view class="product-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="product-item" wx:for="{{products}}" wx:key="_id">
        <image class="product-img" src="{{item.image}}" mode="aspectFill" wx:if="{{item.image}}"/>
        <view class="product-img-placeholder" wx:else><icon type="package" size="40" color="#ccc"/></view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-desc">{{item.category}}</text>
          <view class="product-bottom">
            <text class="product-price" style="color:{{themeColor}}">¥{{item.price}}</text>
            <view class="add-btn" catchtap="addToCart" data-product="{{item}}" style="background:{{themeColor}}">+</view>
          </view>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{products.length === 0}}">
        <text>暂无商品</text>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 飞入小球 -->
<view wx:for="{{balls}}" wx:key="id" class="ball {{item.show ? 'show' : ''}}"
      style="left:{{item.x}}px;top:{{item.y}}px;">
  <view class="ball-inner" style="background:{{themeColor}};box-shadow:0 2px 8px {{themeColor}}99"></view>
</view>

<!-- 底部悬浮购物车栏 -->
<view class="cart-float" wx:if="{{totalCount > 0}}" bindtap="toggleCartPopup">
  <view class="cart-left">
    <view class="cart-icon-wrap {{cartBounce ? 'bounce' : ''}}" id="cartTarget">
      <icon type="cart" size="28" color="{{themeColor}}"/>
      <view class="cart-badge" wx:if="{{totalCount > 0}}" style="background:{{themeColor}}">{{totalCount}}</view>
    </view>
    <view class="cart-price">
      <text class="price-num">¥{{totalPrice}}</text>
      <text class="price-desc" wx:if="{{totalPrice < minPrice}}">差¥{{diffPrice}}起送</text>
      <text class="price-desc ready" wx:else>已满起送价</text>
    </view>
  </view>
  <view class="cart-right" catchtap="goCheckout">
    <view class="checkout-btn" style="background:{{themeColor}};color:#fff">去结算</view>
  </view>
</view>

<!-- 购物车弹窗（半屏，仿饿了么） -->
<view class="cart-popup-mask {{showCartPopup ? 'show' : ''}}" catchtap="closeCartPopup"></view>
<view class="cart-popup {{showCartPopup ? 'show' : ''}}">
  <view class="popup-header">
    <text class="popup-title">已选商品</text>
    <view class="popup-clear" bindtap="clearCartPopup"><icon type="delete" size="16" color="#999"/> 清空</view>
  </view>
  <scroll-view class="popup-list" scroll-y>
    <view class="popup-item" wx:for="{{cartItems}}" wx:key="_id">
      <image class="popup-img" src="{{item.image}}" mode="aspectFill" wx:if="{{item.image}}"/>
      <view class="popup-img-placeholder" wx:else><icon type="package" size="40" color="#ccc"/></view>
      <view class="popup-info">
        <text class="popup-name">{{item.name}}</text>
        <view class="popup-bottom">
          <text class="popup-price" style="color:{{themeColor}}">¥{{item.price}}</text>
          <view class="popup-qty">
            <view class="popup-qty-btn" catchtap="popupDecrease" data-index="{{index}}">-</view>
            <text class="popup-qty-num">{{item.quantity}}</text>
            <view class="popup-qty-btn plus" catchtap="popupIncrease" data-index="{{index}}" style="background:{{themeColor}}">+</view>
          </view>
        </view>
        <text class="popup-subtotal">小计: ¥{{s.f(item.price, item.quantity)}}</text>
      </view>
    </view>
  </scroll-view>
  <view class="popup-footer">
    <view class="popup-total">
      <text>合计: </text>
      <text class="popup-total-price" style="color:{{themeColor}}">¥{{totalPrice}}</text>
    </view>
    <view class="popup-checkout-btn {{totalPrice >= minPrice ? '' : 'disabled'}}" 
          bindtap="popupCheckout"
          style="{{totalPrice >= minPrice ? 'background:' + themeColor : ''}}">
      {{totalPrice >= minPrice ? '去结算' : '还差¥' + diffPrice + '起送'}}
    </view>
  </view>
</view>
