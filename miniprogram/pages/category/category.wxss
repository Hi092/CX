/* 分类页面 */
page { height: 100%; background: #f5f5f5; -webkit-font-smoothing: antialiased; }

.container { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; }

/* 顶部Banner */
.banner-wrap { width: 100%; flex-shrink: 0; }
.banner-img { width: 100%; height: 320rpx; display: block; }
.banner-default { width: 100%; height: 320rpx; display: flex; align-items: center; justify-content: center; }
.banner-text { color: #fff; font-size: 32rpx; font-weight: 600; }

/* 搜索栏 */
.search-bar { padding: 16rpx 24rpx; background: #fff; flex-shrink: 0; border-bottom: 1rpx solid #eee; }
.search-input { background: #f5f5f5; padding: 14rpx 28rpx; border-radius: 36rpx; font-size: 26rpx; }

/* 主内容区 - 关键：flex:1 + overflow:hidden 让scroll-view正确滚动 */
.main-content { flex: 1; display: flex; overflow: hidden; min-height: 0; }

/* 左侧分类 */
.category-list { width: 160rpx; background: #f8f8f8; flex-shrink: 0; overflow: hidden; }
.category-item { padding: 28rpx 16rpx; text-align: center; font-size: 28rpx; color: #666; position: relative; line-height: 1.3; }
.category-item.active { font-weight: 600; }
.active-bar { position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 6rpx; height: 32rpx; border-radius: 0 6rpx 6rpx 0; }

/* 右侧商品 */
.product-list { flex: 1; background: #fff; overflow: hidden; }
.product-item { display: flex; padding: 24rpx 28rpx; border-bottom: 1rpx solid #f0f0f0; align-items: center; }
.product-img { width: 140rpx; height: 140rpx; border-radius: 16rpx; margin-right: 24rpx; flex-shrink: 0; background: #f5f5f5; }
.product-img-placeholder { width: 140rpx; height: 140rpx; border-radius: 16rpx; margin-right: 24rpx; flex-shrink: 0; background: #f5f5f5; display: flex; align-items: center; justify-content: center; font-size: 56rpx; }
.product-info { flex: 1; min-width: 0; }
.product-name { font-size: 30rpx; color: #333; font-weight: 600; display: block; line-height: 1.4; }
.product-desc { font-size: 24rpx; color: #aaa; margin-top: 6rpx; display: block; line-height: 1.3; }
.product-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.product-price { font-size: 30rpx; font-weight: 700; line-height: 1; }
.add-btn { width: 48rpx; height: 48rpx; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 700; line-height: 1; flex-shrink: 0; }
.empty-tip { text-align: center; padding: 80rpx; color: #bbb; font-size: 26rpx; }

/* 飞入小球 */
.ball { position: fixed; width: 32rpx; height: 32rpx; pointer-events: none; z-index: 9999; display: none; }
.ball.show { display: block; }
.ball-inner { width: 32rpx; height: 32rpx; border-radius: 50%; }

/* 底部购物车栏 */
.cart-float { position: fixed; left: 20rpx; right: 20rpx; bottom: 20rpx; height: 100rpx; background: #2d2d2d; border-radius: 50rpx; display: flex; align-items: center; z-index: 200; padding: 0 12rpx 0 0; box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.2); }
.cart-left { flex: 1; display: flex; align-items: center; }
.cart-icon-wrap { position: relative; width: 96rpx; height: 96rpx; background: #3a3a3a; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: -28rpx; margin-left: -8rpx; border: 6rpx solid #2d2d2d; transition: transform 0.15s ease; }
.cart-icon-wrap.bounce { animation: cartBounce 0.35s ease; }
@keyframes cartBounce { 0% { transform: scale(1); } 25% { transform: scale(1.35); } 55% { transform: scale(0.85); } 100% { transform: scale(1); } }
.cart-icon { font-size: 44rpx; line-height: 1; }
.cart-badge { position: absolute; top: -4rpx; right: -4rpx; color: #fff; font-size: 20rpx; font-weight: 600; min-width: 32rpx; height: 32rpx; border-radius: 16rpx; text-align: center; line-height: 32rpx; padding: 0 8rpx; }
.cart-price { margin-left: 20rpx; }
.price-num { font-size: 34rpx; color: #fff; font-weight: 700; display: block; line-height: 1.2; }
.price-desc { font-size: 20rpx; color: #999; display: block; line-height: 1.2; margin-top: 2rpx; }
.price-desc.ready { color: #4CAF50; }
.cart-right { flex-shrink: 0; }
.checkout-btn { color: #fff; padding: 16rpx 36rpx; border-radius: 36rpx; font-size: 26rpx; font-weight: 600; }
