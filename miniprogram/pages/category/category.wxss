/* 分类页样式 */
.container { background: #f5f5f5; min-height: 100vh; width: 100vw; box-sizing: border-box; padding-bottom: env(safe-area-inset-bottom); }
.shop-header { padding: 16px 12px; padding-top: calc(16px + env(safe-area-inset-top)); }
.shop-info-row { display: flex; align-items: center; }
.shop-avatar { width: 52px; height: 52px; border-radius: 50%; margin-right: 10px; border: 2px solid #f0f0f0; }
.shop-avatar-default { width: 52px; height: 52px; border-radius: 50%; background: #f0f0f0; display: flex; align-items: center; justify-content: center; font-size: 26px; margin-right: 10px; }
.shop-detail { flex: 1; }
.shop-name-row { display: flex; align-items: center; gap: 8px; }
.shop-name { font-size: 17px; font-weight: bold; color: #333; }
.shop-status-tag { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 500; }
.shop-status-tag.open { background: #E8F5E9; color: #4CAF50; }
.shop-status-tag.closed { background: #FFF3E0; color: #FF9800; }
.shop-sub { font-size: 12px; color: #999; margin-top: 2px; }
.reach-tip { font-size: 12px; color: #999; margin-top: 2px; }

/* Banner轮播 */
.banner-swiper { height: 150px; margin: 0 12px 10px; border-radius: 10px; overflow: hidden; background: #f5f5f5; }
.banner-swiper .banner-img { width: 100%; height: 100%; }

/* 搜索 */
.search-bar { padding: 0 12px 10px; background: transparent; }
.search-wrap { display: flex; align-items: center; background: #f0f0f0; border-radius: 8px; padding: 8px 12px; width: 100%; box-sizing: border-box; }
.search-icon { font-size: 16px; margin-right: 6px; }
.search-input { flex: 1; font-size: 14px; height: 20px; }

/* 左右分栏 */
.main-content { display: flex; background: #f5f5f5; height: calc(100vh - 320px); min-height: 300px; }
.category-list { width: 85px; background: #f9f9f9; height: 100%; }
.category-item { position: relative; padding: 15px 0; text-align: center; font-size: 14px; color: #666; }
.category-item.active { font-weight: bold; }
.active-bar { position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 3px; height: 18px; border-radius: 0 3px 3px 0; }
.product-list { flex: 1; background: #fff; height: 100%; }
.product-item { display: flex; padding: 12px; border-bottom: 1px solid #f9f9f9; }
.product-img { width: 80px; height: 80px; border-radius: 8px; margin-right: 10px; flex-shrink: 0; }
.product-img-placeholder { width: 80px; height: 80px; border-radius: 8px; margin-right: 10px; background: #f5f5f5; display: flex; align-items: center; justify-content: center; font-size: 28px; flex-shrink: 0; }
.product-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.product-name { font-size: 14px; font-weight: 600; color: #333; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.product-desc { font-size: 12px; color: #999; margin-top: 3px; }
.product-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 5px; }
.product-price { font-size: 15px; font-weight: bold; }
.add-btn { width: 24px; height: 24px; border-radius: 50%; color: #fff; font-size: 16px; display: flex; align-items: center; justify-content: center; }
.empty-tip { text-align: center; padding: 40px; color: #ccc; font-size: 13px; }

/* 飞入小球 */
.ball { position: fixed; z-index: 999; width: 16px; height: 16px; pointer-events: none; opacity: 0; transform: scale(0.2); transition: all 0.45s cubic-bezier(0.48, -0.2, 0.82, 0.25); }
.ball.show { opacity: 1; transform: scale(1); }
.ball-inner { width: 100%; height: 100%; border-radius: 50%; }

/* 底部悬浮购物车 */
.cart-float { position: fixed; bottom: calc(50px + env(safe-area-inset-bottom)); left: 12px; right: 12px; height: 50px; border-radius: 25px; background: #2d2d2d; display: flex; align-items: center; justify-content: space-between; z-index: 100; }
.cart-left { display: flex; align-items: center; padding-left: 65px; }
.cart-icon-wrap { position: absolute; left: 12px; bottom: 2px; width: 50px; height: 50px; border-radius: 50%; background: #333; border: 3px solid #2d2d2d; display: flex; align-items: center; justify-content: center; z-index: 2; }
.cart-icon-wrap.bounce { animation: cartBounce 0.3s; }
@keyframes cartBounce { 0% { transform: scale(1); } 50% { transform: scale(1.3); } 100% { transform: scale(1); } }
.cart-icon { font-size: 22px; }
.cart-badge { position: absolute; top: -2px; right: -2px; min-width: 18px; height: 18px; border-radius: 9px; color: #fff; font-size: 11px; font-weight: bold; display: flex; align-items: center; justify-content: center; padding: 0 4px; box-sizing: border-box; }
.cart-price { display: flex; flex-direction: column; }
.price-num { color: #fff; font-size: 16px; font-weight: bold; }
.price-desc { color: #999; font-size: 11px; margin-top: 1px; }
.price-desc.ready { color: #fff; }
.cart-right { padding-right: 6px; }
.checkout-btn { padding: 8px 18px; border-radius: 20px; font-size: 13px; font-weight: 600; }

/* 购物车弹窗 */
.cart-popup-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 150; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
.cart-popup-mask.show { opacity: 1; pointer-events: auto; }
.cart-popup { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 16px 16px 0 0; z-index: 160; max-height: 60vh; display: flex; flex-direction: column; transform: translateY(100%); transition: transform 0.3s; padding-bottom: env(safe-area-inset-bottom); }
.cart-popup.show { transform: translateY(0); }
.popup-header { display: flex; justify-content: space-between; align-items: center; padding: 15px 16px; border-bottom: 1px solid #f5f5f5; }
.popup-title { font-size: 15px; font-weight: bold; color: #333; }
.popup-clear { font-size: 12px; color: #999; }
.popup-list { max-height: 40vh; padding: 0 16px; }
.popup-item { display: flex; align-items: center; padding: 12px 0; border-bottom: 1px solid #f9f9f9; }
.popup-img { width: 50px; height: 50px; border-radius: 8px; margin-right: 10px; flex-shrink: 0; }
.popup-img-placeholder { width: 50px; height: 50px; border-radius: 8px; margin-right: 10px; background: #f5f5f5; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
.popup-info { flex: 1; min-width: 0; }
.popup-name { font-size: 14px; font-weight: 600; color: #333; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.popup-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 6px; }
.popup-price { font-size: 14px; font-weight: bold; }
.popup-qty { display: flex; align-items: center; gap: 8px; }
.popup-qty-btn { width: 26px; height: 26px; border-radius: 50%; background: #f5f5f5; display: flex; align-items: center; justify-content: center; font-size: 16px; color: #666; }
.popup-qty-btn.plus { color: #fff; }
.popup-qty-num { font-size: 14px; font-weight: 600; min-width: 16px; text-align: center; }
.popup-subtotal { font-size: 12px; color: #999; margin-top: 2px; display: block; }
.popup-footer { display: flex; justify-content: space-between; align-items: center; padding: 10px 16px; border-top: 1px solid #f5f5f5; }
.popup-total { font-size: 14px; color: #333; }
.popup-total-price { font-size: 18px; font-weight: bold; }
.popup-checkout-btn { padding: 8px 20px; border-radius: 20px; font-size: 14px; font-weight: 600; color: #fff; background: #ccc; }
.popup-checkout-btn.disabled { background: #ccc; }
