/* 分类页面样式（默认启动页） */
page {
  height: 100%;
  overflow: hidden;
}

.container {
  padding: 0;
  margin: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: #fff;
  display: flex;
  flex-direction: column;
}

/* 顶部通栏 */
.shop-header {
  background: linear-gradient(180deg, #FFF3E6, #FFFFFF);
  padding: 30rpx 30rpx 20rpx;
  padding-top: calc(30rpx + env(safe-area-inset-top));
  width: 100%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.shop-info-row {
  display: flex;
  align-items: center;
}

.shop-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  border: 2rpx solid #FFD9B3;
}

.shop-avatar-default {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFF3E6;
  border: 2rpx solid #FFD9B3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.shop-detail {
  display: flex;
  flex-direction: column;
}

.shop-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.shop-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.shop-status-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.shop-status-tag.open {
  background: #E8F5E9;
  color: #4CAF50;
}

.shop-status-tag.closed {
  background: #FFF3E0;
  color: #FF9800;
}

.shop-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 0 20rpx 16rpx;
  background: #fff;
  flex-shrink: 0;
}

.search-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 主内容区 */
.main-content {
  display: flex;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

/* 左侧分类栏 */
.category-list {
  width: 180rpx;
  background: #f5f5f5;
  height: 100%;
}

.category-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 25rpx 10rpx;
  font-size: 24rpx;
  color: #666;
}

.category-item.active {
  background: #fff;
  font-weight: bold;
}

.active-bar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  border-radius: 3rpx;
}

/* 右侧商品列表 */
.product-list {
  flex: 1;
  background: #fff;
  padding: 20rpx;
  height: 100%;
}

.product-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.product-item:last-child {
  border-bottom: none;
}

.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.product-img-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.product-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 15rpx;
}

.product-price {
  font-size: 32rpx;
  font-weight: bold;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

/* 加入购物车小球动画 */
.ball {
  position: fixed;
  z-index: 999;
  pointer-events: none;
  opacity: 0;
  transition: none;
}

.ball.show {
  opacity: 1;
}

.ball-inner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}

/* 底部购物车栏 */
.cart-float {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-bottom: 16rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.cart-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.cart-icon-wrap {
  position: relative;
  margin-right: 16rpx;
  margin-left: 16rpx;
}

.cart-icon {
  font-size: 48rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.cart-price {
  display: flex;
  flex-direction: column;
}

.price-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.price-desc {
  font-size: 20rpx;
  color: #999;
}

.price-desc.ready {
  color: #4CAF50;
}

.cart-right {
  margin-left: 20rpx;
}

.checkout-btn {
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* ===== 购物车弹窗 ===== */
.cart-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.cart-popup-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.cart-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-width: 100vw;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.cart-popup.show {
  transform: translateY(0);
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.popup-clear {
  font-size: 26rpx;
  color: #999;
}

.popup-list {
  flex: 1;
  height: 0;
  max-height: 50vh;
  padding: 0 24rpx;
  overflow-x: hidden;
}

.popup-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f9f9f9;
}

.popup-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.popup-img-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.popup-info {
  flex: 1;
  min-width: 0;
}

.popup-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.popup-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  top: -7rpx;
  height: 48rpx;
}

.popup-price {
  font-size: 30rpx;
  font-weight: bold;
}

.popup-subtotal {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.popup-qty {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.popup-qty-btn {
  width: 44rpx;
  height: 44rpx;
  border: 1rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
}

.popup-qty-btn.plus {
  color: #fff;
  border: none;
}

.popup-qty-num {
  font-size: 28rpx;
  min-width: 40rpx;
  text-align: center;
}

.popup-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-bottom: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.popup-total {
  font-size: 30rpx;
  color: #333;
}

.popup-total-price {
  font-size: 36rpx;
  font-weight: bold;
}

.popup-checkout-btn {
  background: #ccc;
  color: #fff;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.popup-checkout-btn.disabled {
  background: #ccc;
}
