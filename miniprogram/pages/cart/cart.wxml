<!--购物车页面-->
<view class="container">
  <!-- 空购物车 -->
  <view class="empty" wx:if="{{cart.length === 0}}">
    <view class="icon">🛒</view>
    <text class="text">购物车空空如也</text>
    <button class="btn-primary" bindtap="goShopping">去逛逛</button>
  </view>

  <!-- 购物车列表 -->
  <block wx:else>
    <!-- 头部 -->
    <view class="cart-header">
      <text>购物车 ({{totalCount}}件)</text>
      <text class="clear-btn" bindtap="clearCart">清空</text>
    </view>

    <!-- 商品列表 -->
    <view class="cart-item" wx:for="{{cart}}" wx:key="_id">
      <view class="checkbox {{item.selected ? 'checked' : ''}}" 
            bindtap="toggleSelect" data-index="{{index}}">
        <text wx:if="{{item.selected}}">✓</text>
      </view>
      
      <image src="{{item.image || '/images/default.png'}}" class="cart-img" mode="aspectFill"/>
      
      <view class="cart-info">
        <text class="cart-name">{{item.name}}</text>
        <view class="cart-bottom">
          <view class="price">
            <text class="symbol">¥</text>
            <text class="num">{{item.price}}</text>
          </view>
          <view class="quantity-control">
            <view class="qty-btn" bindtap="decrease" data-index="{{index}}">-</view>
            <text class="qty-num">{{item.quantity}}</text>
            <view class="qty-btn" bindtap="increase" data-index="{{index}}">+</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部结算栏 -->
    <view class="cart-footer">
      <view class="select-all" bindtap="toggleSelectAll">
        <view class="checkbox {{selectAll ? 'checked' : ''}}">
          <text wx:if="{{selectAll}}">✓</text>
        </view>
        <text>全选</text>
      </view>
      
      <view class="total">
        <text>合计: </text>
        <text class="price">
          <text class="symbol">¥</text>
          <text class="num">{{totalPrice}}</text>
        </text>
      </view>
      
      <button class="checkout-btn {{totalCount > 0 ? '' : 'disabled'}}" 
              bindtap="checkout">
        去结算({{totalCount}})
      </button>
    </view>
  </block>
</view>
