/* 购物车样式 */
.container { background: #f5f5f5; min-height: 100vh; padding: 0; width: 100%; box-sizing: border-box; }

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  background: linear-gradient(180deg, #FFF3E6, #FFFFFF);
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.cart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.clear-btn {
  color: #999;
  font-size: 26rpx;
  margin-right: 20rpx;
  margin-top: 10rpx;
}

/* 购物车商品项 */
.cart-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  padding: 20rpx;
  margin-bottom: 2rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 24rpx;
  color: #fff;
  margin-top: 30rpx;
  flex-shrink: 0;
}

.checkbox.checked {
  border-color: currentColor;
}

.cart-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.cart-img-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  flex-shrink: 0;
}

.cart-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 160rpx;
}

.cart-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.cart-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.cart-subtotal {
  font-size: 24rpx;
  color: #999;
}

.price {
  font-weight: bold;
}

.symbol {
  font-size: 24rpx;
}

.num {
  font-size: 32rpx;
}

/* 数量控制 */
.quantity-control {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
}

.qty-btn.plus {
  color: #fff;
  border: none;
}

.qty-num {
  font-size: 28rpx;
  min-width: 40rpx;
  text-align: center;
}

/* 底部结算栏 — bottom:0贴底，padding推内容避开tab栏 */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  padding-bottom: calc(50px + env(safe-area-inset-bottom));
}

.footer-main {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx 0;
}

.footer-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.footer-tip.ready {
  color: #4CAF50;
}

.go-shop {
  font-weight: bold;
}

.footer-main {
  display: flex;
  align-items: center;
}

.select-area {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
}

.price-area {
  flex: 1;
  text-align: right;
  margin-right: 20rpx;
}

.total {
  font-size: 28rpx;
}

.total .label {
  color: #333;
  margin-right: 8rpx;
}

.total .price {
  font-weight: bold;
}

.delivery {
  font-size: 22rpx;
  color: #999;
}

.checkout-btn {
  background: #ccc;
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.checkout-btn.disabled {
  background: #ccc;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.empty .icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty .text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty .btn-primary {
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 80rpx;
  font-size: 30rpx;
}
