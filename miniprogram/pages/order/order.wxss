/* 订单确认页样式 */
.container { background: #f5f5f5; min-height: 100vh; padding-bottom: env(safe-area-inset-bottom); }

/* 收货地址 */
.address-card { display: flex; align-items: center; background: #fff; padding: 15px; margin: 10px; border-radius: 12px; }
.address-icon { font-size: 20px; margin-right: 8px; }
.address-info { flex: 1; }
.address-top { margin-bottom: 5px; }
.address-top .name { font-weight: bold; margin-right: 10px; }
.address-top .phone { color: #666; }
.address-detail { font-size: 13px; color: #333; }
.no-address { flex: 1; color: #999; }
.arrow { color: #ccc; font-size: 18px; margin-left: 5px; }

/* 商品卡片 */
.order-card { background: #fff; margin: 10px; border-radius: 12px; padding: 15px; }
.card-title { font-weight: bold; margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid #eee; }
.order-item { display: flex; padding: 10px 0; border-bottom: 1px solid #f5f5f5; }
.order-item:last-child { border-bottom: none; }
.item-img { width: 60px; height: 60px; border-radius: 8px; margin-right: 10px; background: #f5f5f5; flex-shrink: 0; }
.item-img-placeholder { width: 60px; height: 60px; border-radius: 8px; margin-right: 10px; background: #f5f5f5; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
.item-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.item-name { font-size: 14px; color: #333; }
.item-bottom { display: flex; justify-content: space-between; align-items: center; }
.item-qty { color: #999; }

/* 联系商家 */
.contact-card { display: flex; align-items: center; background: #fff; padding: 12px 15px; margin: 10px; border-radius: 12px; }
.contact-icon { font-size: 18px; margin-right: 8px; }
.contact-text { font-size: 14px; color: #333; flex: 1; }
.contact-phone { font-size: 14px; color: #666; margin-right: 5px; }

/* 备注 */
.remark-card { display: flex; align-items: center; background: #fff; padding: 15px; margin: 10px; border-radius: 12px; }
.remark-label { margin-right: 10px; white-space: nowrap; color: #333; }
.remark-input { flex: 1; font-size: 14px; }

/* 价格明细 */
.price-card { background: #fff; margin: 10px; border-radius: 12px; padding: 15px; }
.price-row { display: flex; justify-content: space-between; padding: 5px 0; font-size: 14px; }
.price-row.total { font-weight: bold; font-size: 16px; }
.free { color: #4CAF50; }
.divider { height: 1px; background: #eee; margin: 8px 0; }
.price .symbol { font-size: 12px; }
.price .num { font-size: 16px; font-weight: bold; }

/* 提交栏 - 固定在底部，全屏宽度 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 15px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  box-shadow: 0 -1px 5px rgba(0,0,0,0.05);
  z-index: 100;
}
.submit-info { font-size: 15px; display: flex; align-items: baseline; gap: 2px; }
.submit-info .symbol { font-size: 12px; }
.submit-info .num { font-size: 18px; font-weight: bold; }
.submit-btn { color: #fff; border: none; border-radius: 25px; padding: 8px 25px; font-size: 15px; margin: 0; }
.submit-btn::after { border: none; }
