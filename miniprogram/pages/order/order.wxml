<!--订单确认页-->
<view class="container">
  <view class="address-card" bindtap="chooseAddress">
    <block wx:if="{{address}}">
      <view class="address-info">
        <view class="address-top">
          <text class="name">{{address.name}}</text>
          <text class="phone">{{address.phone}}</text>
        </view>
        <view class="address-detail">{{address.community}} {{address.building}}栋{{address.unit}}单元 {{address.room}}</view>
      </view>
      <text class="arrow">›</text>
    </block>
    <block wx:else>
      <view class="no-address"><text>请选择收货地址</text><text class="arrow">›</text></view>
    </block>
  </view>
  <view class="order-card">
    <view class="card-title">商品清单</view>
    <view class="order-item" wx:for="{{items}}" wx:key="_id">
      <image src="{{item.image}}" class="item-img" mode="aspectFill" wx:if="{{item.image}}"/>
      <view class="item-img-placeholder" wx:else>📦</view>
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <view class="item-bottom">
          <view class="price" style="color:{{themeColor}}"><text class="symbol">¥</text><text class="num">{{item.price}}</text></view>
          <text class="item-qty">x{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="remark-card">
    <text class="remark-label">备注</text>
    <input class="remark-input" placeholder="选填" bindinput="onRemarkInput" value="{{remark}}"/>
  </view>
  <view class="price-card">
    <view class="price-row"><text>商品金额</text><text>¥{{totalPrice}}</text></view>
    <view class="price-row"><text>配送费</text><text wx:if="{{totalPrice >= freeDeliveryPrice}}" class="free">免配送费</text><text wx:else>¥{{deliveryFee}}</text></view>
    <view class="divider"></view>
    <view class="price-row total"><text>实付金额</text><text class="price" style="color:{{themeColor}}"><text class="symbol">¥</text><text class="num">{{finalPrice}}</text></text></view>
  </view>
  <view class="submit-bar">
    <view class="submit-info"><text>合计: </text><text class="price" style="color:{{themeColor}}"><text class="symbol">¥</text><text class="num">{{finalPrice}}</text></text></view>
    <button class="submit-btn" bindtap="submitOrder" loading="{{loading}}" style="background:{{themeColor}}">提交订单</button>
  </view>
</view>
