<!--订单详情-->
<view class="container" wx:if="{{order}}">
  <view class="status-bar" style="background:linear-gradient(135deg, {{themeColor}}, {{themeColor}}88)">
    <icon type="{{order.status === 'completed' ? 'check' : order.status === 'delivering' ? 'truck' : 'time'}}" size="24" color="#fff"/>
    <text class="status-text">{{order.statusText}}</text>
  </view>

  <view class="card address-card">
    <view class="address-top">
      <text class="name">{{order.address.name}}</text>
      <text class="phone" style="color:{{themeColor}}" bindtap="callPhone" data-phone="{{order.address.phone}}">{{order.address.phone}}</text>
    </view>
    <text class="address-detail">{{order.address.community}} {{order.address.building}}栋 {{order.address.unit}}单元 {{order.address.room}}</text>
  </view>

  <view class="card">
    <view class="card-title">商品清单</view>
    <view class="item" wx:for="{{order.items}}" wx:key="productId">
      <text class="item-name">{{item.name}}</text>
      <text class="item-qty">x{{item.quantity}}</text>
      <text class="item-price">¥{{item.price}}</text>
    </view>
  </view>

  <view class="card">
    <view class="row"><text>商品金额</text><text>¥{{order.totalPrice}}</text></view>
    <view class="row"><text>配送费</text><text wx:if="{{order.deliveryFee === 0}}" class="free">免配送费</text><text wx:else>¥{{order.deliveryFee}}</text></view>
    <view class="divider"></view>
    <view class="row total"><text>实付金额</text><text class="price" style="color:{{themeColor}}">¥{{order.finalPrice}}</text></view>
  </view>

  <view class="card">
    <view class="card-title">订单信息</view>
    <view class="row"><text class="label">订单号</text><text class="value">{{order.orderNo}}</text></view>
    <view class="row"><text class="label">下单时间</text><text class="value">{{order.createTimeText}}</text></view>
    <view class="row" wx:if="{{order.payTimeText}}"><text class="label">支付时间</text><text class="value">{{order.payTimeText}}</text></view>
    <view class="row" wx:if="{{order.deliveryTimeText}}"><text class="label">配送时间</text><text class="value">{{order.deliveryTimeText}}</text></view>
    <view class="row" wx:if="{{order.completeTimeText}}"><text class="label">完成时间</text><text class="value">{{order.completeTimeText}}</text></view>
    <view class="row" wx:if="{{order.remark}}"><text class="label">备注</text><text class="value">{{order.remark}}</text></view>
  </view>

  <view class="pending-actions" wx:if="{{!isAdmin && order.status === 'pending'}}">
    <view class="pending-note">未支付，{{order.pendingExpireText}}</view>
    <view class="action-row">
      <button class="action-btn danger" bindtap="deletePendingOrder" disabled="{{deleting}}">{{deleting ? '删除中...' : '删除订单'}}</button>
      <button class="action-btn primary" style="background:{{themeColor}}" bindtap="payAgain" disabled="{{paying}}">{{paying ? '支付中...' : '重新付款'}}</button>
    </view>
  </view>

  <view class="contact-btn" style="color:{{themeColor}}" bindtap="callShop"><icon type="phone" size="16" color="{{themeColor}}"/> 联系商家</view>
</view>

<view class="loading" wx:if="{{loading}}"><text>加载中...</text></view>
