/* 订单详情 */
.container { background: #f5f5f5; min-height: 100vh; padding-bottom: 30rpx; }
.status-bar { padding: 40rpx 30rpx; display: flex; align-items: center; color: #fff; }
.status-icon { font-size: 40rpx; margin-right: 16rpx; }
.status-text { font-size: 36rpx; font-weight: bold; }
.card { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx; }
.address-card { margin-top: -20rpx; border-radius: 0 0 16rpx 16rpx; }
.address-top { margin-bottom: 8rpx; }
.name { font-weight: bold; margin-right: 20rpx; font-size: 30rpx; }
.phone { font-weight: 600; }
.address-detail { font-size: 26rpx; color: #666; }
.card-title { font-weight: bold; font-size: 28rpx; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #f0f0f0; }
.item { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f9f9f9; }
.item:last-child { border-bottom: none; }
.item-name { flex: 1; font-size: 28rpx; }
.item-qty { color: #999; margin: 0 20rpx; font-size: 26rpx; }
.item-price { font-size: 28rpx; color: #333; }
.row { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 28rpx; }
.row .label { color: #999; }
.row .value { color: #333; }
.row.total { font-weight: bold; font-size: 32rpx; }
.price { font-weight: bold; }
.free { color: #4CAF50; }
.divider { height: 1rpx; background: #f0f0f0; margin: 12rpx 0; }
.pending-actions { margin: 20rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.pending-note { color: #f39c12; background: #fff7e6; padding: 16rpx; border-radius: 12rpx; font-size: 26rpx; margin-bottom: 20rpx; }
.action-row { display: flex; justify-content: flex-end; gap: 20rpx; }
.action-btn { margin: 0; min-width: 180rpx; height: 64rpx; line-height: 64rpx; border-radius: 32rpx; font-size: 28rpx; }
.action-btn::after { border: none; }
.action-btn.danger { background: #fff0f0; color: #e74c3c; }
.action-btn.primary { color: #fff; }
.action-btn[disabled] { opacity: 0.7; }
.contact-btn { margin: 20rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; text-align: center; font-size: 30rpx; font-weight: 600; }
.loading { text-align: center; padding: 100rpx; color: #999; }
