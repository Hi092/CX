.container { background: #f5f5f5; min-height: 100vh; }
.tabs { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #666; position: relative; display: flex; flex-direction: column; align-items: center; }
.tab.active { font-weight: 600; }
.tab-line { width: 40rpx; height: 4rpx; border-radius: 2rpx; margin-top: 8rpx; }
.badge { position: absolute; top: 6rpx; right: 20rpx; min-width: 32rpx; height: 32rpx; line-height: 32rpx; font-size: 20rpx; color: #fff; background: #e74c3c; border-radius: 16rpx; padding: 0 8rpx; text-align: center; font-weight: 600; }
.order-list { padding: 20rpx; }
.swipe-row { position: relative; overflow: hidden; margin-bottom: 20rpx; border-radius: 16rpx; }
.delete-bg { position: absolute; right: 0; top: 0; bottom: 0; width: 150rpx; background: #e74c3c; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }
.order-card { position: relative; background: #fff; border-radius: 16rpx; overflow: hidden; transform: translateX(0); transition: transform 0.2s ease; }
.order-card.swiped { transform: translateX(-150rpx); }
.order-header { display: flex; justify-content: space-between; align-items: center; padding: 20rpx; border-bottom: 1rpx solid #f5f5f5; }
.order-no { font-size: 24rpx; color: #999; }
.order-status { font-size: 24rpx; font-weight: 600; }
.order-items { padding: 20rpx; }
.order-item { display: flex; justify-content: space-between; padding: 10rpx 0; }
.item-name { flex: 1; font-size: 26rpx; }
.item-qty { margin: 0 20rpx; color: #999; }
.item-price { color: #333; }
.pending-tip { margin: 0 20rpx 10rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: #fff7e6; color: #f39c12; font-size: 24rpx; line-height: 1.5; }
.order-footer { display: flex; justify-content: space-between; align-items: center; padding: 20rpx; border-top: 1rpx solid #f5f5f5; }
.order-time { color: #999; font-size: 24rpx; }
.order-total { font-size: 28rpx; font-weight: bold; }
.order-actions { display: flex; justify-content: flex-end; padding: 0 20rpx 20rpx; gap: 16rpx; }
.mini-btn { margin: 0; min-width: 130rpx; height: 56rpx; line-height: 56rpx; padding: 0 22rpx; border-radius: 28rpx; font-size: 24rpx; }
.mini-btn::after { border: none; }
.mini-btn.plain { background: #f5f5f5; color: #666; }
.mini-btn.danger { background: #fff0f0; color: #e74c3c; }
.mini-btn.primary { color: #fff; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 100rpx; color: #999; }
.empty text { margin-top: 20rpx; }
.loading { text-align: center; padding: 100rpx; color: #999; }
