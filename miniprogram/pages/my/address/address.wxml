<!--收货地址-->
<view class="container">
  <view class="address-list">
    <view class="address-card {{item.isDefault ? 'default' : ''}}"
          style="{{item.isDefault ? 'border-color:' + themeColor : ''}}"
          wx:for="{{addresses}}" wx:key="_id"
          bindtap="selectAddress" data-id="{{item._id}}">
      <view class="address-info">
        <view class="address-top">
          <text class="address-name">{{item.name}}</text>
          <text class="address-phone">{{item.phone}}</text>
          <text class="default-tag" wx:if="{{item.isDefault}}" style="background:{{themeColor}}">默认</text>
        </view>
        <text class="address-detail">{{item.community}} {{item.building}}号楼 {{item.unit ? item.unit + '单元 ' : ''}}{{item.room}}</text>
      </view>
      <view class="address-actions">
        <text class="action-edit" style="color:{{themeColor}}" catchtap="editAddress" data-id="{{item._id}}">编辑</text>
        <text class="action-delete" catchtap="deleteAddress" data-id="{{item._id}}">删除</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{addresses.length === 0}}">
    <icon type="location" size="48" color="#ccc"/>
    <text class="empty-text">暂无收货地址</text>
  </view>

  <view class="add-btn" style="color:{{themeColor}}" bindtap="addAddress">+ 新增收货地址</view>
</view>
