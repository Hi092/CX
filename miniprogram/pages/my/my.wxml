<!--我的页面-->
<view class="container">
  <!-- 用户信息 -->
  <view class="user-header">
    <block wx:if="{{userInfo}}">
      <image src="{{userInfo.avatarUrl}}" class="avatar" mode="aspectFill"/>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickName}}</text>
        <text class="user-id">ID: {{userInfo.nickName}}</text>
      </view>
    </block>
    <block wx:else>
      <view class="avatar-placeholder">👤</view>
      <button class="login-btn" bindtap="login">点击登录</button>
    </block>
  </view>

  <!-- 订单状态 -->
  <view class="order-status">
    <view class="status-item" bindtap="goPage" data-url="/pages/my/orders?status=pending">
      <view class="status-icon">
        <text>💳</text>
        <view class="badge" wx:if="{{orderCount.pending > 0}}">{{orderCount.pending}}</view>
      </view>
      <text class="status-text">待付款</text>
    </view>
    <view class="status-item" bindtap="goPage" data-url="/pages/my/orders?status=delivering">
      <view class="status-icon">
        <text>📦</text>
        <view class="badge" wx:if="{{orderCount.delivering > 0}}">{{orderCount.delivering}}</view>
      </view>
      <text class="status-text">待配送</text>
    </view>
    <view class="status-item" bindtap="goPage" data-url="/pages/my/orders?status=completed">
      <view class="status-icon">
        <text>✅</text>
      </view>
      <text class="status-text">已完成</text>
    </view>
    <view class="status-item" bindtap="goPage" data-url="/pages/my/orders">
      <view class="status-icon">
        <text>📋</text>
      </view>
      <text class="status-text">全部订单</text>
    </view>
  </view>

  <!-- 商家入口（仅管理员可见） -->
  <view class="admin-entry" wx:if="{{isAdmin}}" bindtap="goAdmin">
    <view class="admin-icon">🏪</view>
    <view class="admin-info">
      <text class="admin-title">店铺管理</text>
      <text class="admin-desc">管理商品、查看订单</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-card">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="text"
          bindtap="goPage" data-url="{{item.url}}" data-action="{{item.action}}">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-text">{{item.text}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn" wx:if="{{userInfo}}" bindtap="logout">
    退出登录
  </view>
</view>
