<!--我的页面-->
<view class="container">
  <!-- 用户头部（浅橙到白色渐变） -->
  <view class="user-header">
    <block wx:if="{{userInfo}}">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" wx:if="{{userInfo.avatarUrl}}" bindtap="changeAvatar"/>
      <view class="avatar-default" bindtap="changeAvatar" wx:else><icon type="user" size="40" color="#fff"/></view>
      <view class="nickname">{{userInfo.nickName || '用户'}}</view>
    </block>
    <block wx:else>
      <view class="avatar-default" bindtap="changeAvatar"><icon type="user" size="40" color="#fff"/></view>
      <view class="login-area">
        <button class="login-btn" bindtap="login">点击登录</button>
      </view>
    </block>
  </view>

  <!-- 订单状态 -->
  <view class="order-status">
    <view class="status-item" bindtap="goOrders" data-status="pending">
      <view class="status-icon-wrap">
        <icon type="wallet" size="24" color="{{themeColor}}"/>
        <view class="badge" wx:if="{{badgeCounts.pending > 0}}">{{badgeCounts.pending > 99 ? '99+' : badgeCounts.pending}}</view>
      </view>
      <text class="status-text">待付款</text>
    </view>
    <view class="status-item" bindtap="goOrders" data-status="paid">
      <view class="status-icon-wrap">
        <icon type="receipt" size="24" color="{{themeColor}}"/>
        <view class="badge" wx:if="{{badgeCounts.paid > 0}}">{{badgeCounts.paid > 99 ? '99+' : badgeCounts.paid}}</view>
      </view>
      <text class="status-text">待配送</text>
    </view>
    <view class="status-item" bindtap="goOrders" data-status="delivering">
      <view class="status-icon-wrap">
        <icon type="rider" size="24" color="{{themeColor}}"/>
        <view class="badge" wx:if="{{badgeCounts.delivering > 0}}">{{badgeCounts.delivering > 99 ? '99+' : badgeCounts.delivering}}</view>
      </view>
      <text class="status-text">配送中</text>
    </view>
    <view class="status-item" bindtap="goOrders" data-status="completed">
      <view class="status-icon-wrap">
        <icon type="circle-check" size="24" color="{{themeColor}}"/>
      </view>
      <text class="status-text">已完成</text>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goAddress">
      <icon type="location" size="20" color="{{themeColor}}"/>
      <text class="menu-text">收货地址</text>
      <icon type="arrow-right" size="16" color="#ccc"/>
    </view>
    <view class="menu-item" bindtap="callShop">
      <icon type="phone" size="20" color="{{themeColor}}"/>
      <text class="menu-text">联系商家</text>
      <icon type="arrow-right" size="16" color="#ccc"/>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <icon type="settings" size="20" color="{{themeColor}}"/>
      <text class="menu-text">设置</text>
      <icon type="arrow-right" size="16" color="#ccc"/>
    </view>
  </view>

  <!-- 版本号 -->
  <view class="version" bindtap="onVersionTap">
    <text>v2026.06.05</text>
  </view>

  <!-- 密码弹窗（白色圆角设计） -->
  <view class="pwd-modal" wx:if="{{showModal}}">
    <view class="pwd-mask" bindtap="closeModal"></view>
    <view class="pwd-box">
      <view class="pwd-title">商家验证</view>
      <input class="pwd-input" type="text" password 
             placeholder="请输入商家密码" value="{{pwdInput}}"
             bindinput="onPwdInput" bindconfirm="doVerify"/>
      <view class="pwd-btns">
        <view class="pwd-btn cancel" bindtap="closeModal">取消</view>
        <view class="pwd-btn confirm" bindtap="doVerify" style="background:{{themeColor}}">确定</view>
      </view>
    </view>
  </view>
</view>
