/* 我的页面样式 */
.container { padding: 0; margin: 0; width: 100%; box-sizing: border-box; }

/* 用户头部：浅橙到白色渐变 */
.user-header {
  background: linear-gradient(180deg, #FFF3E6, #FFFFFF);
  padding: 72rpx 40rpx 50rpx;
  padding-top: calc(72rpx + env(safe-area-inset-top));
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFD9B3;
  margin-right: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-default {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FFF3E6;
  border: 2rpx solid #FFD9B3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.login-area {
  flex: 1;
}

.login-btn {
  background: transparent;
  color: #FF8C40;
  border: 2rpx solid #FFD9B3;
  border-radius: 40rpx;
  padding: 12rpx 40rpx;
  font-size: 28rpx;
  display: inline-block;
}

.login-btn::after {
  border: none;
}

/* 订单状态 - 等宽对齐 */
.order-status {
  display: flex;
  justify-content: space-between;
  background: #fff;
  padding: 30rpx 20rpx;
  margin: 20rpx;
  border-radius: 16rpx;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.status-icon-wrap {
  position: relative;
  margin-bottom: 10rpx;
}

.badge {
  position: absolute;
  top: -12rpx;
  right: -20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  font-size: 20rpx;
  color: #fff;
  background: #e74c3c;
  border-radius: 16rpx;
  padding: 0 8rpx;
  text-align: center;
  font-weight: 600;
}

.status-text {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
}

/* 菜单卡片 */
.menu-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  margin-left: 20rpx;
}

/* 版本号 */
.version {
  text-align: center;
  padding: 40rpx;
  color: #ccc;
  font-size: 24rpx;
}

/* 密码弹窗 */
.pwd-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pwd-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.pwd-box {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 560rpx;
  z-index: 1;
}

.pwd-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.pwd-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.pwd-btns {
  display: flex;
  gap: 20rpx;
}

.pwd-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.pwd-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.pwd-btn.confirm {
  color: #fff;
}
