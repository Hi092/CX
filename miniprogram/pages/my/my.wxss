/* 我的页面 */
page { background: #f5f5f5; }

.user-header { padding: 50px 20px 30px; display: flex; align-items: center; }
.avatar-placeholder { width: 56px; height: 56px; border-radius: 50%; background: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; font-size: 28px; margin-right: 14px; }
.nickname { font-size: 18px; font-weight: 600; color: #fff; display: block; }
.login-btn { background: rgba(255,255,255,0.25); color: #fff; border: none; border-radius: 22px; padding: 8px 24px; font-size: 15px; }
.login-btn::after { border: none; }

.order-status { display: flex; justify-content: space-around; background: #fff; padding: 18px 10px; margin: 10px; border-radius: 10px; }
.status-item { display: flex; flex-direction: column; align-items: center; }
.status-icon { font-size: 26px; margin-bottom: 6px; }
.status-text { font-size: 13px; color: #666; }

.menu-card { background: #fff; margin: 10px; border-radius: 10px; overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 16px 14px; border-bottom: 1px solid #f5f5f5; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 20px; margin-right: 12px; }
.menu-text { flex: 1; font-size: 15px; color: #333; }
.arrow { color: #ccc; font-size: 18px; }

.version { text-align: center; padding: 16px; color: #ddd; font-size: 12px; }

.pwd-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999; display: flex; align-items: center; justify-content: center; }
.pwd-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); }
.pwd-box { position: relative; background: #fff; border-radius: 12px; padding: 24px; width: 280px; z-index: 1; }
.pwd-title { font-size: 17px; font-weight: 600; text-align: center; margin-bottom: 16px; color: #333; }
.pwd-input { background: #f5f5f5; border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; font-size: 16px; }
.pwd-btns { display: flex; gap: 10px; }
.pwd-btn { flex: 1; text-align: center; padding: 10px; border-radius: 8px; font-size: 15px; }
.pwd-btn.cancel { background: #f5f5f5; color: #666; }
.pwd-btn.confirm { color: #fff; }
