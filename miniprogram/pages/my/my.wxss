/* 我的页面样式 */

/* 用户头部 */
.user-header {
  background: linear-gradient(135deg, #FF6B00, #FF8C40);
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  align-items: center;
  margin: -20rpx -20rpx 20rpx;
  border-radius: 0 0 30rpx 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  margin-right: 30rpx;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 30rpx;
}

.user-info {
  flex: 1;
  color: #fff;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  opacity: 0.8;
}

.login-btn {
  background: rgba(255,255,255,0.3);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
}

.login-btn::after {
  border: none;
}

/* 订单状态 */
.order-status {
  display: flex;
  justify-content: space-around;
  background: #fff;
  padding: 30rpx;
  margin: 20rpx;
  border-radius: 16rpx;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-icon {
  position: relative;
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -15rpx;
  background: #FF6B00;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.status-text {
  font-size: 24rpx;
  color: #666;
}

/* 商家入口 */
.admin-entry {
  display: flex;
  align-items: center;
  background: #FFF3E6;
  border: 2rpx dashed #FF6B00;
  padding: 30rpx;
  margin: 20rpx;
  border-radius: 16rpx;
}

.admin-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.admin-info {
  flex: 1;
}

.admin-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #FF6B00;
  display: block;
  margin-bottom: 5rpx;
}

.admin-desc {
  font-size: 24rpx;
  color: #999;
}

/* 菜单卡片 */
.menu-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.arrow {
  color: #ccc;
  font-size: 32rpx;
}

/* 退出登录 */
.logout-btn {
  text-align: center;
  padding: 30rpx;
  margin: 40rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  color: #FF6B00;
  font-size: 30rpx;
}
