.container { background: #f5f5f5; min-height: 100vh; padding: 20rpx; }
.settings-card { background: #fff; border-radius: 16rpx; overflow: hidden; margin-bottom: 30rpx; }
.settings-item { display: flex; justify-content: space-between; padding: 30rpx; border-bottom: 1rpx solid #f5f5f5; }
.settings-item:last-child { border-bottom: none; }
.settings-label { color: #333; font-size: 30rpx; }
.settings-value { color: #999; font-size: 30rpx; }
.logout-btn { text-align: center; padding: 30rpx; background: #fff; border-radius: 16rpx; font-size: 30rpx; }
