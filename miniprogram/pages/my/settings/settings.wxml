<!--设置-->
<view class="container">
  <view class="settings-card">
    <view class="settings-item">
      <text class="settings-label">账号</text>
      <text class="settings-value">{{userInfo.nickName || '未登录'}}</text>
    </view>
    <view class="settings-item">
      <text class="settings-label">版本</text>
      <text class="settings-value">v1.0.0</text>
    </view>
    <view class="settings-item" bindtap="clearCache">
      <text class="settings-label">清除缓存</text>
      <text class="settings-value">清除</text>
    </view>
  </view>
  
  <view class="logout-btn" wx:if="{{userInfo}}" bindtap="logout" style="color:{{themeColor}}">退出登录</view>
</view>
